// ═══════════════════════════════════════════════════════════════════
// Fortleva — Phase 1 + Phase 2 core-domain schema.
// docs/DATA_MODEL.md is the canonical naming authority and carries the
// full per-model rationale; comments here state only load-bearing
// constraints. Portal identity (Contact auth stack) lands in Phase 3 per
// docs/PLAN.md. Physical names are snake_case (§1.3) so RLS policies,
// REVOKEs and triggers in migrations resolve unquoted.
// ═══════════════════════════════════════════════════════════════════

// Connection URLs live outside the schema in Prisma 7: the CLI reads
// DIRECT_URL (unpooled, owner role — Migrate only) from prisma.config.ts;
// the runtime client gets DATABASE_URL (pooled, app_runtime — restricted,
// no BYPASSRLS) via the pg driver adapter in src/db.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ───────────────────────────────────────────────────────────────────
// IDENTITY & AUTH — member side (Better Auth ≥ 1.6.11)
// ───────────────────────────────────────────────────────────────────

/// Global member identity; membership is tenant-scoped via Member.
/// platformRole is THE platform-plane flag authorizePlatform() reads;
/// role is Better Auth admin-plugin plumbing mirrored from it, never
/// read by any authorization path.
model User {
  id               String    @id @default(uuid(7))
  name             String
  email            String    @unique // lowercase-normalized at write
  emailVerified    Boolean   @default(false) @map("email_verified")
  image            String?
  locale           String?
  platformRole     String?   @map("platform_role") // "SUPERADMIN" | null
  role             String? // admin-plugin mirror only
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled") // twoFactor-plugin required column
  banned           Boolean   @default(false)
  banReason        String?   @map("ban_reason")
  banExpires       DateTime? @map("ban_expires") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions    Session[]
  accounts    Account[]
  twoFactor   TwoFactor?
  passkeys    Passkey[]
  memberships Member[]

  @@map("user")
}

enum SessionPlane {
  MEMBER
  PLATFORM
}

/// plane is the structural barrier between planes (SECURITY.md §3.3):
/// each route group's middleware accepts only its own cookie AND its
/// own plane value. activeTenantId is a UX pointer only — authorization
/// always re-derives membership.
model Session {
  id             String       @id @default(uuid(7))
  token          String       @unique
  userId         String       @map("user_id")
  plane          SessionPlane @default(MEMBER)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  ipAddress      String?      @map("ip_address")
  userAgent      String?      @map("user_agent")
  impersonatedBy String?      @map("impersonated_by")
  activeTenantId String?      @map("active_tenant_id")
  /// Last interactive second-factor verification on THIS session
  /// (SECURITY.md §3.5 step-up): stamped on TOTP/backup-code verify at
  /// sign-in and by verifyStepUp(); NULL = no fresh factor. Trusted-device
  /// logins leave it NULL on purpose.
  mfaVerifiedAt  DateTime?    @map("mfa_verified_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7))
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  password              String? // scrypt hash, credential provider only
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

/// secret and backupCodes are ENCRYPTED with the app AES-256-GCM field
/// service before storage (SECURITY.md §6).
model TwoFactor {
  id                      String    @id @default(uuid(7))
  userId                  String    @unique @map("user_id")
  secret                  String
  backupCodes             String    @map("backup_codes")
  // twoFactor-plugin (1.6.26) required columns: enrollment is pending
  // until the first code verifies; lockout counters for sign-in verify.
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor")
}

model Passkey {
  id           String   @id @default(uuid(7))
  userId       String   @map("user_id")
  name         String?
  publicKey    String   @map("public_key")
  credentialID String   @unique @map("credential_id")
  counter      Int
  deviceType   String   @map("device_type")
  backedUp     Boolean  @map("backed_up")
  transports   String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey")
}

// ───────────────────────────────────────────────────────────────────
// TENANT ROOT & PLATFORM CONFIG
// ───────────────────────────────────────────────────────────────────

enum TenantStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  OFFBOARDING
  CLOSED
}

/// entitlements is the versioned JSON of DATA_MODEL.md §4 — the shape
/// ships in Phase 1 with everything-on defaults; Stripe fills it in
/// Phase 7. bankgiro/plusgiro/iban/bic/databaseUrl are ENCRYPTED.
model Tenant {
  id                    String       @id @default(uuid(7))
  name                  String
  legalName             String?      @map("legal_name")
  slug                  String       @unique
  status                TenantStatus @default(TRIALING)
  entitlements          Json
  entitlementsUpdatedAt DateTime?    @map("entitlements_updated_at") @db.Timestamptz(6)
  planCode              String?      @map("plan_code")
  stripeCustomerId      String?      @unique @map("stripe_customer_id")
  stripeSubscriptionId  String?      @map("stripe_subscription_id")
  billingCurrency       String?      @map("billing_currency") @db.Char(3)
  trialEndsAt           DateTime?    @map("trial_ends_at") @db.Timestamptz(6)
  permissionsVersion    Int          @default(1) @map("permissions_version")
  cell                  String?
  databaseUrl           String?      @map("database_url")
  orgNr                 String?      @map("org_nr")
  vatNumber             String?      @map("vat_number")
  seat                  String?
  fSkattApproved        Boolean      @default(false) @map("f_skatt_approved")
  addressLine1          String?      @map("address_line1")
  addressLine2          String?      @map("address_line2")
  postalCode            String?      @map("postal_code")
  city                  String?
  countryCode           String?      @map("country_code") @db.Char(2)
  bankgiro              String?
  plusgiro              String?
  iban                  String?
  bic                   String?
  storageUsedBytes      BigInt       @default(0) @map("storage_used_bytes")
  defaultLocale         String       @default("sv") @map("default_locale")
  suspendedAt           DateTime?    @map("suspended_at") @db.Timestamptz(6)
  offboardedAt          DateTime?    @map("offboarded_at") @db.Timestamptz(6)
  deleteAfter           DateTime?    @map("delete_after") @db.Timestamptz(6)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  members         Member[]
  invites         MemberInvite[]
  roles           Role[]
  preferences     TenantPreference[]
  counters        TenantCounter[]
  keys            TenantKey[]
  documents       Document[]
  fileObjects     FileObject[]
  clients         Client[]
  contacts        Contact[]
  memberClients   MemberClient[]
  memberProjects  MemberProject[]
  projects        Project[]
  projectVersions ProjectVersion[]
  milestones      Milestone[]
  services        Service[]

  @@map("tenant")
}

/// Keyed rows, not one JSON blob — every flip individually audited.
model TenantPreference {
  id                String   @id @default(uuid(7))
  tenantId          String   @map("tenant_id")
  key               String
  value             Json
  updatedByMemberId String?  @map("updated_by_member_id") // attribution, no FK
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("tenant_preference")
}

/// Monotonic counters for human-facing numbers with NO legal gap-free
/// requirement. Invoices use InvoiceSeries (Phase 4), never this.
model TenantCounter {
  tenantId String @map("tenant_id")
  key      String
  value    Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, key])
  @@map("tenant_counter")
}

/// Engineering-owned, temporary, never monetization (gate 4 of 4).
model FeatureFlag {
  id              String    @id @default(uuid(7))
  key             String    @unique
  description     String
  defaultOn       Boolean   @default(false) @map("default_on")
  tenantOverrides Json?     @map("tenant_overrides")
  removeBy        DateTime? @map("remove_by") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flag")
}

// ───────────────────────────────────────────────────────────────────
// CRYPTO — per-tenant envelope keys (SECURITY.md §6, DATA_MODEL.md §4)
// ───────────────────────────────────────────────────────────────────

enum TenantKeyStatus {
  ACTIVE
  RETIRED
}

/// One DEK per tenant per key version. wrappedDek is the 32-byte DEK
/// wrapped by the env root keyring (v1 field-encryption format);
/// rootKeyId names the wrapping key (the KMS seam). Class A: a contact
/// never reads this table. Rows are never deleted while v2 ciphertext
/// under them exists — retirement is a status flip.
model TenantKey {
  id         String          @id @default(uuid(7))
  tenantId   String          @map("tenant_id")
  keyId      String          @map("key_id") // short id, e.g. "t1"
  wrappedDek String          @map("wrapped_dek")
  rootKeyId  String          @map("root_key_id")
  status     TenantKeyStatus @default(ACTIVE)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  retiredAt  DateTime?       @map("retired_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, keyId])
  @@index([tenantId, status])
  @@map("tenant_key")
}

// ───────────────────────────────────────────────────────────────────
// MEMBERSHIP & AUTHORIZATION (tenant plane)
// ───────────────────────────────────────────────────────────────────

enum MemberStatus {
  ACTIVE
  SUSPENDED
}

/// Role is NEVER a column here — many-to-many via MemberRole.
model Member {
  id          String       @id @default(uuid(7))
  tenantId    String       @map("tenant_id")
  userId      String       @map("user_id")
  status      MemberStatus @default(ACTIVE)
  title       String?
  timezone    String?      @db.VarChar(64) // IANA zone, e.g. "Europe/Stockholm"
  workCountry String?      @map("work_country") @db.Char(2) // ISO 3166-1 alpha-2
  hoursPerDay Decimal?     @map("hours_per_day") @db.Decimal(4, 2)
  invitedById String?      @map("invited_by_id") // attribution, no FK
  joinedAt    DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)
  suspendedAt DateTime?    @map("suspended_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant          @relation(fields: [tenantId], references: [id])
  user               User            @relation(fields: [userId], references: [id])
  memberRoles        MemberRole[]
  clientAssignments  MemberClient[]
  projectAssignments MemberProject[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id]) // composite-FK target
  @@index([userId])
  @@map("member")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

/// Stores a token HASH, never the raw token.
model MemberInvite {
  id                String       @id @default(uuid(7))
  tenantId          String       @map("tenant_id")
  email             String // lowercase-normalized
  proposedRoleIds   Json         @map("proposed_role_ids") // Role.id[], subset-checked
  tokenHash         String       @unique @map("token_hash")
  status            InviteStatus @default(PENDING)
  invitedByMemberId String       @map("invited_by_member_id") // attribution, no FK
  expiresAt         DateTime     @map("expires_at") @db.Timestamptz(6)
  acceptedAt        DateTime?    @map("accepted_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, email])
  @@index([expiresAt])
  @@map("member_invite")
}

/// GLOBAL seeded catalog; codes are immutable `resource:verb`, from
/// AUTHZ.md §3.1's closed 64-code catalog. module is NOT nullable —
/// core permissions carry the literal "core". requiresMfa is the ✦ set.
model Permission {
  id          String  @id @default(uuid(7))
  code        String  @unique
  description String
  module      String
  requiresMfa Boolean @default(false) @map("requires_mfa")

  rolePermissions RolePermission[]

  @@map("permission")
}

/// Template lineage + drift tracking (B3: tracked-diff-additive) ships
/// in this first migration. templateKey values are canonical:
/// "owner" | "manager" | "admin" | "employee" — AUTHZ.md §7.3 pins the
/// last-owner invariant to templateKey = 'owner'.
model Role {
  id              String   @id @default(uuid(7))
  tenantId        String   @map("tenant_id")
  name            String
  description     String?
  isSystem        Boolean  @default(false) @map("is_system")
  templateKey     String?  @map("template_key")
  clonedFromKey   String?  @map("cloned_from_key")
  templateVersion Int?     @map("template_version")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  rolePermissions RolePermission[]
  memberRoles     MemberRole[]

  @@unique([tenantId, name])
  @@unique([tenantId, id]) // composite-FK target
  @@index([tenantId, templateKey])
  @@map("role")
}

enum RolePermissionSource {
  TEMPLATE
  TENANT_GRANT
  TENANT_REVOKE
}

/// TENANT_REVOKE rows are tombstones: NOT effective, exist so a tenant's
/// deliberate trim survives template propagation. Effective set = rows
/// where source != TENANT_REVOKE. Every change bumps
/// Tenant.permissionsVersion in the same transaction.
model RolePermission {
  tenantId     String               @map("tenant_id")
  roleId       String               @map("role_id")
  permissionId String               @map("permission_id")
  source       RolePermissionSource @default(TENANT_GRANT)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([tenantId, roleId, permissionId])
  @@index([tenantId, permissionId])
  @@map("role_permission")
}

/// Effective permissions = union across held roles (additive-only).
/// Role relation is Restrict: a role still assigned cannot be deleted.
model MemberRole {
  tenantId     String   @map("tenant_id")
  memberId     String   @map("member_id")
  roleId       String   @map("role_id")
  assignedById String?  @map("assigned_by_id") // attribution, no FK
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  member Member @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Cascade)
  role   Role   @relation(fields: [tenantId, roleId], references: [tenantId, id])

  @@id([tenantId, memberId, roleId])
  @@index([tenantId, roleId])
  @@map("member_role")
}

// ───────────────────────────────────────────────────────────────────
// CORE DOMAIN — clients, contacts, assignments, projects (Phase 2)
// DATA_MODEL.md §6.3–§6.6 as amended 2026-08-16. RLS: Client/Contact
// are class B_clientScoped (structural gate — client match only);
// MemberClient/MemberProject class A; Project/ProjectVersion/Milestone/
// Service class B_projectScoped with the trigger-maintained
// portal_enabled column (TENANCY.md §7.2). Composite FKs everywhere.
// ───────────────────────────────────────────────────────────────────

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

enum VatProfile {
  SE_DOMESTIC
  EU_REVERSE_CHARGE
  OUTSIDE_SCOPE
}

/// A customer of a tenant; a company record, never a login. The
/// client-root: its portal_gate is `id = app.client_id` (no client_id
/// column of its own). internalNotes is INTERNAL-ONLY — never selected
/// by any portal projection, never in AuditEvent.metadata.
model Client {
  id                   String       @id @default(uuid(7))
  tenantId             String       @map("tenant_id")
  name                 String
  orgNr                String?      @map("org_nr")
  vatNumber            String?      @map("vat_number")
  vatNumberValidatedAt DateTime?    @map("vat_number_validated_at") @db.Timestamptz(6)
  vatProfile           VatProfile?  @map("vat_profile")
  countryCode          String?      @map("country_code") @db.Char(2)
  addressLine1         String?      @map("address_line1")
  addressLine2         String?      @map("address_line2")
  postalCode           String?      @map("postal_code")
  city                 String?
  billingEmail         String?      @map("billing_email")
  invoiceLocale        String?      @map("invoice_locale")
  status               ClientStatus @default(ACTIVE)
  internalNotes        String?      @map("internal_notes") // INTERNAL-ONLY
  archivedAt           DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  contacts        Contact[]
  memberClients   MemberClient[]
  projects        Project[]
  projectVersions ProjectVersion[]
  milestones      Milestone[]
  services        Service[]
  documents       Document[]

  @@unique([tenantId, id]) // composite-FK target for ALL client-scoped children
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@map("client")
}

/// Fixed portal capability profiles (AUTHZ.md §8 is the source of truth
/// for the split). Contacts never enter tenant RBAC.
enum ContactPortalProfile {
  CONTACT_PRIMARY
  CONTACT_COLLABORATOR
}

enum ContactPortalStatus {
  NO_ACCESS
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

/// A person at a client — RECORD ONLY in Phase 2 (portalStatus stays
/// NO_ACCESS). The portal identity stack (ContactSession/Account/
/// Verification, second Better Auth instance) lands in Phase 3 and maps
/// onto the identity columns kept here. Structural class-B row: gated
/// by client match only (no visibility column).
model Contact {
  id            String               @id @default(uuid(7))
  tenantId      String               @map("tenant_id")
  clientId      String               @map("client_id")
  name          String
  email         String               @unique // v1 global (single app domain); (tenantId, email) is the permanent unique
  emailVerified Boolean              @default(false) @map("email_verified")
  image         String?
  title         String?
  phone         String?
  portalProfile ContactPortalProfile @default(CONTACT_COLLABORATOR) @map("portal_profile")
  portalStatus  ContactPortalStatus  @default(NO_ACCESS) @map("portal_status")
  invitedAt     DateTime?            @map("invited_at") @db.Timestamptz(6)
  invitedById   String?              @map("invited_by_id") // Member.id, attribution, no FK
  activatedAt   DateTime?            @map("activated_at") @db.Timestamptz(6)
  locale        String?
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  client Client @relation(fields: [tenantId, clientId], references: [tenantId, id])

  @@unique([tenantId, email])
  @@unique([tenantId, id]) // composite-FK target
  @@index([tenantId, clientId])
  @@map("contact")
}

/// Explicit member↔client assignment (decision #5, deny-default):
/// scope over the client AND all its projects. Class A.
model MemberClient {
  tenantId     String   @map("tenant_id")
  memberId     String   @map("member_id")
  clientId     String   @map("client_id")
  assignedById String?  @map("assigned_by_id") // attribution, no FK
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  member Member @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Cascade)
  client Client @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, memberId, clientId])
  @@index([tenantId, clientId])
  @@map("member_client")
}

/// Explicit member↔project assignment: scope over that single project
/// and its child records plus the parent client's card (AUTHZ.md §4).
/// Class A.
model MemberProject {
  tenantId     String   @map("tenant_id")
  memberId     String   @map("member_id")
  projectId    String   @map("project_id")
  assignedById String?  @map("assigned_by_id") // attribution, no FK
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  member  Member  @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Cascade)
  project Project @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, memberId, projectId])
  @@index([tenantId, projectId])
  @@map("member_project")
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

/// What the portal hours widget may show (CONTACT_PRIMARY only). Never per-member.
enum HoursSharingMode {
  NONE
  HOURS
  BILLABLE_AMOUNT
}

/// Progress-update cadence intent (Phase 3); ProjectUpdateSchedule (Phase 5) enforces it.
enum UpdateCadence {
  NONE
  WEEKLY
  BIWEEKLY
  MONTHLY
}

/// Belongs to exactly one Client. key (<= 8 chars, [A-Z][A-Z0-9]*,
/// CHECK in migration) is the human WorkItem prefix ("ACME-12").
/// portalEnabled is THE project-level portal gate: fanned out by
/// trigger to portal_enabled on every projectScoped table; the row's
/// own portal_gate is `client_id = app.client_id AND portal_enabled`
/// (structural row — no visibility column). INTERNAL-ONLY fields
/// (never in a portal projection): repoUrl, hostingNotes, internalNotes,
/// leadMemberId. hostingNotes holds POINTERS only, never secrets.
model Project {
  id                 String           @id @default(uuid(7))
  tenantId           String           @map("tenant_id")
  clientId           String           @map("client_id")
  key                String           @db.VarChar(8)
  name               String
  type               String? // free text — tenant taxonomy
  scopeSummary       String?          @map("scope_summary")
  status             ProjectStatus    @default(PLANNED)
  startDate          DateTime?        @map("start_date") @db.Timestamptz(6)
  launchDate         DateTime?        @map("launch_date") @db.Timestamptz(6)
  productionUrl      String?          @map("production_url")
  stagingUrl         String?          @map("staging_url")
  repoUrl            String?          @map("repo_url") // INTERNAL-ONLY
  hostingNotes       String?          @map("hosting_notes") // INTERNAL-ONLY, pointers only
  internalNotes      String?          @map("internal_notes") // INTERNAL-ONLY
  portalEnabled      Boolean          @default(false) @map("portal_enabled")
  hoursSharingMode   HoursSharingMode @default(NONE) @map("hours_sharing_mode")
  billingCurrency    String?          @map("billing_currency") @db.Char(3)
  defaultBillable    Boolean          @default(true) @map("default_billable")
  leadMemberId       String?          @map("lead_member_id") // Member.id, attribution, no FK
  updateCadence      UpdateCadence    @default(NONE) @map("update_cadence")
  autoArchiveMonths  Int?             @map("auto_archive_months")
  autoStartParent    Boolean          @default(false) @map("auto_start_parent")
  autoCompleteParent Boolean          @default(false) @map("auto_complete_parent")
  archivedAt         DateTime?        @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  client         Client           @relation(fields: [tenantId, clientId], references: [tenantId, id])
  memberProjects MemberProject[]
  versions       ProjectVersion[]
  milestones     Milestone[]
  services       Service[]
  documents      Document[]

  @@unique([tenantId, id]) // composite-FK target
  @@unique([tenantId, key])
  @@index([tenantId, clientId, status])
  @@index([tenantId, status])
  @@map("project")
}

enum ProjectVersionStatus {
  DRAFT
  SHIPPED
}

enum ApprovalStatus {
  NOT_REQUESTED
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

/// What shipped when, with release notes (the version timeline).
/// Structural-status gate (DATA_MODEL.md §6.5): no visibility column —
/// SHIPPED ⇒ client-visible; portal_gate = client match AND
/// status = 'SHIPPED' AND portal_enabled. Approval columns become
/// contact-writable in Phase 3.
model ProjectVersion {
  id                  String               @id @default(uuid(7))
  tenantId            String               @map("tenant_id")
  clientId            String               @map("client_id") // denormalised for portal RLS
  projectId           String               @map("project_id")
  version             String
  title               String?
  releaseNotes        String?              @map("release_notes")
  status              ProjectVersionStatus @default(DRAFT)
  shippedAt           DateTime?            @map("shipped_at") @db.Timestamptz(6)
  portalEnabled       Boolean              @default(false) @map("portal_enabled") // trigger-maintained
  approvalStatus      ApprovalStatus       @default(NOT_REQUESTED) @map("approval_status")
  approvalRequestedAt DateTime?            @map("approval_requested_at") @db.Timestamptz(6)
  approvalDecidedAt   DateTime?            @map("approval_decided_at") @db.Timestamptz(6)
  approvalByContactId String?              @map("approval_by_contact_id") // attribution, no FK
  approvalNote        String?              @map("approval_note")
  createdByMemberId   String?              @map("created_by_member_id") // attribution, no FK
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  client  Client  @relation(fields: [tenantId, clientId], references: [tenantId, id])
  project Project @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, projectId, version])
  @@unique([tenantId, id]) // composite-FK target (WorkItem.fixedInVersionId)
  @@index([tenantId, clientId, shippedAt])
  @@map("project_version")
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  DONE
  CANCELLED
}

/// The agency "phase" unit. rank is text COLLATE "C" (fractional-
/// indexing; the collation is applied in the migration SQL — Prisma
/// cannot express it). Carries visibility like every content row.
model Milestone {
  id            String          @id @default(uuid(7))
  tenantId      String          @map("tenant_id")
  clientId      String          @map("client_id") // denormalised for portal RLS
  projectId     String          @map("project_id")
  name          String
  description   String?
  status        MilestoneStatus @default(PLANNED)
  dueAt         DateTime?       @map("due_at") @db.Timestamptz(6)
  completedAt   DateTime?       @map("completed_at") @db.Timestamptz(6)
  rank          String // text COLLATE "C" (migration SQL)
  visibility    Visibility      @default(INTERNAL)
  portalEnabled Boolean         @default(false) @map("portal_enabled") // trigger-maintained
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  client  Client  @relation(fields: [tenantId, clientId], references: [tenantId, id])
  project Project @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id]) // composite-FK target (WorkItem.milestoneId)
  @@unique([tenantId, projectId, rank])
  @@index([tenantId, clientId, visibility])
  @@map("milestone")
}

enum ServiceKind {
  ONE_TIME
  RECURRING
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ServiceStatus {
  ACTIVE
  PAUSED
  ENDED
}

/// What the client buys — a RECORD with renewal dates, not a billing
/// engine. projectId optional: portal_enabled is trigger-maintained
/// (TRUE when projectId is NULL, so the two-term client gate applies
/// in effect; else the project's switch). internalNotes INTERNAL-ONLY.
model Service {
  id              String           @id @default(uuid(7))
  tenantId        String           @map("tenant_id")
  clientId        String           @map("client_id")
  projectId       String?          @map("project_id")
  name            String
  description     String?
  kind            ServiceKind
  billingInterval BillingInterval? @map("billing_interval")
  priceExVat      Decimal?         @map("price_ex_vat") @db.Decimal(12, 2)
  currency        String?          @db.Char(3)
  status          ServiceStatus    @default(ACTIVE)
  startedAt       DateTime?        @map("started_at") @db.Timestamptz(6)
  renewsAt        DateTime?        @map("renews_at") @db.Timestamptz(6)
  endsAt          DateTime?        @map("ends_at") @db.Timestamptz(6)
  internalNotes   String?          @map("internal_notes") // INTERNAL-ONLY
  visibility      Visibility       @default(INTERNAL)
  portalEnabled   Boolean          @default(false) @map("portal_enabled") // trigger-maintained
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  client  Client   @relation(fields: [tenantId, clientId], references: [tenantId, id])
  project Project? @relation(fields: [tenantId, projectId], references: [tenantId, id])

  @@unique([tenantId, id]) // composite-FK target (InvoiceLine.serviceId)
  @@index([tenantId, clientId, status])
  @@index([tenantId, renewsAt])
  @@map("service")
}

// ───────────────────────────────────────────────────────────────────
// DOCUMENTS & FILES (file bytes live in R2 EU; DB holds metadata)
// ───────────────────────────────────────────────────────────────────

enum Visibility {
  INTERNAL // THE DEFAULT, everywhere — worst-bug guard (§5)
  CLIENT_VISIBLE
}

enum AttachableType {
  CLIENT
  PROJECT
  PROJECT_VERSION
  MILESTONE
  SERVICE
  CONTRACT
  INVOICE
  ISSUE // DEPRECATED — never used; new anchors use WORK_ITEM (enum stays additive)
  WORK_ITEM // 2W
  COMMENT // 2W
  PROJECT_UPDATE // Phase 3
  CREDENTIAL // 3V — non-secret attachments only
  ASSET // 3V
}

/// Drives the portal "Files & deliverables" grouping, the Client
/// Timeline and the approval flow (DELIVERABLE only, Phase 3).
enum DocumentKind {
  GENERAL
  DELIVERABLE
  REPORT
  EXPORT
}

/// clientId nullable = tenant-internal. CHECK constraint in migration:
/// CLIENT_VISIBLE requires clientId. Composite FKs to Client/Project.
/// (attachedToType, attachedToId) is a presentation anchor —
/// authorization never traverses it.
/// portalEnabled (class B_projectScoped, TENANCY.md §7.2) is trigger-
/// maintained, never written by the app: TRUE when projectId is NULL
/// (a client-level document has no project switch to honour), else the
/// project's portalEnabled. The portal_gate ANDs it in.
model Document {
  id                 String          @id @default(uuid(7))
  tenantId           String          @map("tenant_id")
  clientId           String?         @map("client_id")
  projectId          String?         @map("project_id")
  name               String
  kind               DocumentKind    @default(GENERAL)
  tags               String[]        @default([])
  visibility         Visibility      @default(INTERNAL)
  portalEnabled      Boolean         @default(false) @map("portal_enabled") // trigger-maintained
  attachedToType     AttachableType? @map("attached_to_type")
  attachedToId       String?         @map("attached_to_id")
  createdByMemberId  String?         @map("created_by_member_id") // attribution, no FK
  createdByContactId String?         @map("created_by_contact_id") // attribution, no FK
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  client   Client?       @relation(fields: [tenantId, clientId], references: [tenantId, id])
  project  Project?      @relation(fields: [tenantId, projectId], references: [tenantId, id])
  versions FileVersion[]

  @@unique([tenantId, id])
  @@index([tenantId, clientId, visibility])
  @@index([tenantId, projectId, kind])
  @@index([tenantId, attachedToType, attachedToId])
  // Composite GIN needs the btree_gin extension (created in migration 001)
  @@index([tenantId(ops: raw("text_ops")), tags], type: Gin)
  @@map("document")
}

/// Current version = max versionNumber. The portal never queries this
/// layer — downloads resolve through Document's visibility check.
model FileVersion {
  id                  String   @id @default(uuid(7))
  tenantId            String   @map("tenant_id")
  documentId          String   @map("document_id")
  versionNumber       Int      @map("version_number")
  fileObjectId        String   @map("file_object_id")
  note                String?
  uploadedByMemberId  String?  @map("uploaded_by_member_id") // attribution, no FK
  uploadedByContactId String?  @map("uploaded_by_contact_id") // attribution, no FK
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document   Document   @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Cascade)
  fileObject FileObject @relation(fields: [tenantId, fileObjectId], references: [tenantId, id])

  @@unique([tenantId, documentId, versionNumber])
  @@index([tenantId, fileObjectId])
  @@map("file_version")
}

enum FileObjectStatus {
  PENDING
  COMMITTED
  DELETED
}

enum ScanStatus {
  UNSCANNED
  CLEAN
  INFECTED
}

enum FileKind {
  GENERAL
  INVOICE_PDF
  CONTRACT_PDF
  SIGNATURE_EVIDENCE
  THUMBNAIL
  EXPORT
}

/// One immutable blob in R2 (key: {tenantId}/{fileObjectId}). sizeBytes
/// is THE quota-metering unit; PENDING reserves quota, HEAD-verify then
/// COMMITTED + Tenant.storageUsedBytes increment in one transaction.
model FileObject {
  id                 String           @id @default(uuid(7))
  tenantId           String           @map("tenant_id")
  r2Key              String           @unique @map("r2_key")
  kind               FileKind         @default(GENERAL)
  sha256             String
  sizeBytes          BigInt           @map("size_bytes")
  contentType        String           @map("content_type") // server-side allowlist
  originalFilename   String?          @map("original_filename")
  status             FileObjectStatus @default(PENDING)
  scanStatus         ScanStatus       @default(UNSCANNED) @map("scan_status")
  createdByMemberId  String?          @map("created_by_member_id") // attribution, no FK
  createdByContactId String?          @map("created_by_contact_id") // attribution, no FK
  committedAt        DateTime?        @map("committed_at") @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  versions FileVersion[]

  @@unique([tenantId, id]) // composite-FK target
  @@index([tenantId, status])
  @@index([tenantId, sha256])
  @@index([tenantId, kind])
  @@map("file_object")
}

// ───────────────────────────────────────────────────────────────────
// AUDIT
// ───────────────────────────────────────────────────────────────────

enum ActorType {
  MEMBER
  CONTACT
  PLATFORM_ADMIN
  SYSTEM
}

enum AuditVisibility {
  TENANT
  PLATFORM
}

/// Append-only (runtime role: INSERT+SELECT only + guard trigger).
/// NO foreign keys by design — rows survive their actors, targets and
/// (for PLATFORM events) the tenant. createdAt is DB now(), never
/// app-supplied. metadata is minimized: never plaintext of encrypted
/// fields, never document contents, never personnummer.
model AuditEvent {
  id             String          @id @default(uuid(7))
  tenantId       String?         @map("tenant_id") // NULL = platform-plane event
  actorType      ActorType       @map("actor_type")
  actorId        String?         @map("actor_id")
  impersonatorId String?         @map("impersonator_id")
  action         String // static catalog, "entity.verb"
  targetType     String?         @map("target_type")
  targetId       String?         @map("target_id")
  metadata       Json?
  requestId      String?         @map("request_id")
  ip             String?
  userAgent      String?         @map("user_agent")
  visibility     AuditVisibility
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, targetType, targetId])
  @@index([actorType, actorId, createdAt(sort: Desc)])
  @@index([requestId])
  @@map("audit_event")
}
