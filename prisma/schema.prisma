// ═══════════════════════════════════════════════════════════════════
// Fortleva — Phase 1 + Phase 2 core-domain schema.
// docs/DATA_MODEL.md is the canonical naming authority and carries the
// full per-model rationale; comments here state only load-bearing
// constraints. Portal identity (Contact auth stack) lands in Phase 3 per
// docs/PLAN.md. Physical names are snake_case (§1.3) so RLS policies,
// REVOKEs and triggers in migrations resolve unquoted.
// ═══════════════════════════════════════════════════════════════════

// Connection URLs live outside the schema in Prisma 7: the CLI reads
// DIRECT_URL (unpooled, owner role — Migrate only) from prisma.config.ts;
// the runtime client gets DATABASE_URL (pooled, app_runtime — restricted,
// no BYPASSRLS) via the pg driver adapter in src/db.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ───────────────────────────────────────────────────────────────────
// IDENTITY & AUTH — member side (Better Auth ≥ 1.6.11)
// ───────────────────────────────────────────────────────────────────

/// Global member identity; membership is tenant-scoped via Member.
/// platformRole is THE platform-plane flag authorizePlatform() reads;
/// role is Better Auth admin-plugin plumbing mirrored from it, never
/// read by any authorization path.
model User {
  id               String    @id @default(uuid(7))
  name             String
  email            String    @unique // lowercase-normalized at write
  emailVerified    Boolean   @default(false) @map("email_verified")
  image            String?
  locale           String?
  platformRole     String?   @map("platform_role") // "SUPERADMIN" | null
  role             String? // admin-plugin mirror only
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled") // twoFactor-plugin required column
  banned           Boolean   @default(false)
  banReason        String?   @map("ban_reason")
  banExpires       DateTime? @map("ban_expires") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions    Session[]
  accounts    Account[]
  twoFactor   TwoFactor?
  passkeys    Passkey[]
  memberships Member[]
  authMails   AuthMail[]

  @@map("user")
}

enum SessionPlane {
  MEMBER
  PLATFORM
}

/// plane is the structural barrier between planes (SECURITY.md §3.3):
/// each route group's middleware accepts only its own cookie AND its
/// own plane value. activeTenantId is a UX pointer only — authorization
/// always re-derives membership.
model Session {
  id             String       @id @default(uuid(7))
  token          String       @unique
  userId         String       @map("user_id")
  plane          SessionPlane @default(MEMBER)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  ipAddress      String?      @map("ip_address")
  userAgent      String?      @map("user_agent")
  impersonatedBy String?      @map("impersonated_by")
  activeTenantId String?      @map("active_tenant_id")
  /// View-as-Contact mode pointer (Phase 3 slice 5, SECURITY.md §5.1):
  /// the Contact whose portal view this session is currently inside, or
  /// NULL when it is not. A UX POINTER ONLY, exactly like
  /// `activeTenantId` beside it — authorization is never derived from
  /// it. `/view-as` re-runs `project:manage_portal`, the client scope
  /// check and the contact's own admission on EVERY render, so a stale
  /// or forged pointer renders nothing. What it decides is that the
  /// member performed the ACT, which is why it can only be written by
  /// the audited server action: a bookmarked GET has no pointer to
  /// render and `<Link>` prefetch cannot forge one.
  viewAsContactId String?     @map("view_as_contact_id")
  /// Last interactive second-factor verification on THIS session
  /// (SECURITY.md §3.5 step-up): stamped on TOTP/backup-code verify at
  /// sign-in and by verifyStepUp(); NULL = no fresh factor. Trusted-device
  /// logins leave it NULL on purpose.
  mfaVerifiedAt  DateTime?    @map("mfa_verified_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7))
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  password              String? // scrypt hash, credential provider only
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

/// Shared by the MEMBER and PLATFORM instances, and by several kinds of row
/// that carry the user id in `value`: two-factor sign-in challenges
/// (`2fa-<id>`), trusted devices (`trust-device-…`) and — since C30 — the
/// member plane's reset links, stored as `pwreset#<sha256>`
/// (`src/auth/reset-identifier.ts`, wired as the `storeIdentifier` override in
/// `src/auth/index.ts`). A challenge's `2fa-attempts-…` companion carries a
/// COUNT in `value`, not a user id. Never count or purge by `value` alone, nor
/// by a `2fa-` prefix alone. Identifiers are stored plain except those reset
/// links.
model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

/// ONE ROW PER AUTH MAIL THE MEMBER PLANE HAS DECIDED TO SEND (C30): the
/// ledger the per-recipient hourly cap counts. It is a table of its own
/// because neither mail can be counted where it lives — a confirmation link
/// is a JWT and writes no row at all, and a reset link shares `verification`
/// with the two-factor rows above. It records ATTEMPTS, not surviving links,
/// so using or purging a link cannot refill the budget; a declined request
/// writes nothing, and a send that fails removes its own row. Rows older than
/// the window are pruned by the next reservation for the same user, and the
/// foreign key takes them with the user. No token, no address, no link.
model AuthMail {
  id        String       @id @default(uuid(7))
  userId    String       @map("user_id")
  kind      AuthMailKind
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@map("auth_mail")
}

enum AuthMailKind {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

/// secret and backupCodes are ENCRYPTED BY BETTER AUTH, under
/// BETTER_AUTH_SECRET — not by the app field service, which this comment
/// used to claim (corrected 2026-09-24). Replacing that secret therefore
/// makes every factor undecryptable: read RUNBOOK §5 before rotating it.
/// One row serves the member AND platform planes (userId is unique).
model TwoFactor {
  id                      String    @id @default(uuid(7))
  userId                  String    @unique @map("user_id")
  secret                  String
  backupCodes             String    @map("backup_codes")
  // twoFactor-plugin (1.6.26) required columns: enrollment is pending
  // until the first code verifies; lockout counters for sign-in verify.
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor")
}

model Passkey {
  id           String   @id @default(uuid(7))
  userId       String   @map("user_id")
  name         String?
  publicKey    String   @map("public_key")
  credentialID String   @unique @map("credential_id")
  counter      Int
  deviceType   String   @map("device_type")
  backedUp     Boolean  @map("backed_up")
  transports   String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey")
}

// ───────────────────────────────────────────────────────────────────
// TENANT ROOT & PLATFORM CONFIG
// ───────────────────────────────────────────────────────────────────

enum TenantStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  OFFBOARDING
  CLOSED
}

/// entitlements is the versioned JSON of DATA_MODEL.md §4 — the shape
/// ships in Phase 1 with everything-on defaults; Stripe fills it in
/// Phase 7. bankgiro/plusgiro/iban/bic/databaseUrl are ENCRYPTED.
model Tenant {
  id                    String       @id @default(uuid(7))
  name                  String
  legalName             String?      @map("legal_name")
  slug                  String       @unique
  status                TenantStatus @default(TRIALING)
  entitlements          Json
  entitlementsUpdatedAt DateTime?    @map("entitlements_updated_at") @db.Timestamptz(6)
  planCode              String?      @map("plan_code")
  stripeCustomerId      String?      @unique @map("stripe_customer_id")
  stripeSubscriptionId  String?      @map("stripe_subscription_id")
  billingCurrency       String?      @map("billing_currency") @db.Char(3)
  trialEndsAt           DateTime?    @map("trial_ends_at") @db.Timestamptz(6)
  permissionsVersion    Int          @default(1) @map("permissions_version")
  cell                  String?
  databaseUrl           String?      @map("database_url")
  orgNr                 String?      @map("org_nr")
  vatNumber             String?      @map("vat_number")
  seat                  String?
  fSkattApproved        Boolean      @default(false) @map("f_skatt_approved")
  addressLine1          String?      @map("address_line1")
  addressLine2          String?      @map("address_line2")
  postalCode            String?      @map("postal_code")
  city                  String?
  countryCode           String?      @map("country_code") @db.Char(2)
  bankgiro              String?
  plusgiro              String?
  iban                  String?
  bic                   String?
  /// The note printed on every invoice (Phase 4 slice 107). Protected with the
  /// bank and company columns above (C75 (h)–(j)): the code typed in the form
  /// and every owner mailed in the app, `tenant_payment_details_guard` in the
  /// database (migrations 20261009120000, 20261009150000).
  invoiceFooterNote     String?      @map("invoice_footer_note")
  storageUsedBytes      BigInt       @default(0) @map("storage_used_bytes")
  defaultLocale         String       @default("sv") @map("default_locale")
  suspendedAt           DateTime?    @map("suspended_at") @db.Timestamptz(6)
  offboardedAt          DateTime?    @map("offboarded_at") @db.Timestamptz(6)
  deleteAfter           DateTime?    @map("delete_after") @db.Timestamptz(6)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  members         Member[]
  invites         MemberInvite[]
  contactInvites  ContactInvite[]
  roles           Role[]
  preferences     TenantPreference[]
  counters        TenantCounter[]
  keys            TenantKey[]
  documents       Document[]
  fileObjects     FileObject[]
  clients         Client[]
  contacts        Contact[]
  memberClients   MemberClient[]
  memberProjects  MemberProject[]
  projects        Project[]
  projectVersions ProjectVersion[]
  milestones      Milestone[]
  services        Service[]
  // 2W (work + notifications core):
  workflowStates          WorkflowState[]
  workflowPresets         WorkflowPreset[]
  workItems               WorkItem[]
  workItemActivities      WorkItemActivity[]
  labels                  Label[]
  workItemLabels          WorkItemLabel[]
  workItemCollaborators   WorkItemCollaborator[]
  workItemSubscribers     WorkItemSubscriber[]
  comments                Comment[]
  mentions                Mention[]
  projectTemplates        ProjectTemplate[]
  notifications           Notification[]
  subscriptions           Subscription[]
  notificationPreferences NotificationPreference[]
  emailOutbox             EmailOutbox[]
  pushSubscriptions       PushSubscription[]
  // 2T (time):
  timeEntries                TimeEntry[]
  rateCards                  RateCard[]
  projectBudgets             ProjectBudget[]
  budgetAlerts               BudgetAlert[]
  projectTimeSummaries       ProjectTimeSummary[]
  staffNotices               StaffNotice[]
  staffNoticeAcknowledgments StaffNoticeAcknowledgment[]
  shifts                     Shift[]
  shiftBreaks                ShiftBreak[]
  timeReports                TimeReport[]
  // Phase 3 — progress updates (§6.16):
  projectUpdates                 ProjectUpdate[]
  projectUpdateInternalSnapshots ProjectUpdateInternalSnapshot[]
  projectUpdateReminders         ProjectUpdateReminderSent[]
  projectUpdateTemplates         ProjectUpdateTemplate[]
  workTypes                  WorkType[]
  // Phase 3V — the vault (§6.17):
  credentialItems    CredentialItem[]
  credentialSecrets  CredentialSecret[]
  credentialVersions CredentialVersion[]
  clientAssets       ClientAsset[]
  expirationReminders ExpirationReminderSent[]
  credentialShareLinks CredentialShareLink[]
  contactVaultUnlocks  ContactVaultUnlock[]
  sealedOpenRequests   SealedOpenRequest[]
  credentialAsks       CredentialAsk[]
  // Phase 4 — invoicing (§6.7):
  invoices      Invoice[]
  invoiceLines  InvoiceLine[]
  invoiceSeries InvoiceSeries[]
  invoiceDeliveries InvoiceDelivery[]
  invoicePaymentNotes InvoicePaymentNote[]

  @@map("tenant")
}

/// Keyed rows, not one JSON blob — every flip individually audited.
model TenantPreference {
  id                String   @id @default(uuid(7))
  tenantId          String   @map("tenant_id")
  key               String
  value             Json
  updatedByMemberId String?  @map("updated_by_member_id") // attribution, no FK
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("tenant_preference")
}

/// Monotonic counters for human-facing numbers with NO legal gap-free
/// requirement. Invoices use InvoiceSeries (Phase 4), never this.
model TenantCounter {
  tenantId String @map("tenant_id")
  key      String
  value    Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, key])
  @@map("tenant_counter")
}

/// Engineering-owned, temporary, never monetization (gate 4 of 4).
model FeatureFlag {
  id              String    @id @default(uuid(7))
  key             String    @unique
  description     String
  defaultOn       Boolean   @default(false) @map("default_on")
  tenantOverrides Json?     @map("tenant_overrides")
  removeBy        DateTime? @map("remove_by") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flag")
}

// ───────────────────────────────────────────────────────────────────
// CRYPTO — per-tenant envelope keys (SECURITY.md §6, DATA_MODEL.md §4)
// ───────────────────────────────────────────────────────────────────

enum TenantKeyStatus {
  ACTIVE
  RETIRED
}

/// One DEK per tenant per key version. wrappedDek is the 32-byte DEK
/// wrapped by the env root keyring (v1 field-encryption format);
/// rootKeyId names the wrapping key (the KMS seam). Class A: a contact
/// never reads this table. Rows are never deleted while v2 ciphertext
/// under them exists — retirement is a status flip.
model TenantKey {
  id         String          @id @default(uuid(7))
  tenantId   String          @map("tenant_id")
  keyId      String          @map("key_id") // short id, e.g. "t1"
  wrappedDek String          @map("wrapped_dek")
  rootKeyId  String          @map("root_key_id")
  status     TenantKeyStatus @default(ACTIVE)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  retiredAt  DateTime?       @map("retired_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, keyId])
  @@index([tenantId, status])
  @@map("tenant_key")
}

// ───────────────────────────────────────────────────────────────────
// MEMBERSHIP & AUTHORIZATION (tenant plane)
// ───────────────────────────────────────────────────────────────────

enum MemberStatus {
  ACTIVE
  SUSPENDED
}

/// Role is NEVER a column here — many-to-many via MemberRole.
model Member {
  id          String       @id @default(uuid(7))
  tenantId    String       @map("tenant_id")
  userId      String       @map("user_id")
  status      MemberStatus @default(ACTIVE)
  title       String?
  timezone    String?      @db.VarChar(64) // IANA zone, e.g. "Europe/Stockholm"
  workCountry String?      @map("work_country") @db.Char(2) // ISO 3166-1 alpha-2
  hoursPerDay Decimal?     @map("hours_per_day") @db.Decimal(4, 2)
  invitedById String?      @map("invited_by_id") // attribution, no FK
  joinedAt    DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)
  suspendedAt DateTime?    @map("suspended_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant          @relation(fields: [tenantId], references: [id])
  user               User            @relation(fields: [userId], references: [id])
  memberRoles        MemberRole[]
  clientAssignments  MemberClient[]
  projectAssignments MemberProject[]
  // 2W:
  assignedWorkItems      WorkItem[]             @relation("WorkItemAssigneeMember")
  workItemCollaborations WorkItemCollaborator[]
  workItemSubscriptions  WorkItemSubscriber[]
  subscriptions          Subscription[]
  // 2T:
  timeEntries                TimeEntry[]
  rateCards                  RateCard[]
  shifts                     Shift[]
  shiftBreaks                ShiftBreak[]
  staffNoticeAcknowledgments StaffNoticeAcknowledgment[]
  // Phase 5 slice 106: the devices that get this member's phone notifications.
  pushSubscriptions          PushSubscription[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id]) // composite-FK target
  @@index([userId])
  @@map("member")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

/// Stores a token HASH, never the raw token.
model MemberInvite {
  id                String       @id @default(uuid(7))
  tenantId          String       @map("tenant_id")
  email             String // lowercase-normalized
  proposedRoleIds   Json         @map("proposed_role_ids") // Role.id[], subset-checked
  tokenHash         String       @unique @map("token_hash")
  status            InviteStatus @default(PENDING)
  invitedByMemberId String       @map("invited_by_member_id") // attribution, no FK
  expiresAt         DateTime     @map("expires_at") @db.Timestamptz(6)
  acceptedAt        DateTime?    @map("accepted_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, email])
  @@index([expiresAt])
  @@map("member_invite")
}

/// An invitation to the CLIENT PORTAL, issued against a `Contact` that
/// already exists (Phase 3 — the invite slice). It is the contact twin
/// of `MemberInvite` and deliberately NOT the same table: a member
/// invitation names an EMAIL and creates the `Member` on acceptance,
/// while a contact invitation names a ROW the agency has already
/// recorded, and acceptance only gives that row a credential and flips
/// its `portalStatus`.
///
/// **ONE LIVE INVITATION PER CONTACT is a DATABASE fact this schema
/// cannot express**: `contact_invite_one_live_idx` (migration
/// `20260923030000`) is a UNIQUE index on `(tenant_id, contact_id)`
/// PARTIAL on `status = 'PENDING'`, and Prisma has no syntax for the
/// predicate. It is deliberately NOT declared as a plain `@@unique`
/// here — that would be a lie in the client's own type surface,
/// offering a `findUnique` selector that is not unique across the
/// history of ACCEPTED, REVOKED and EXPIRED rows. The service sees it
/// as a P2002 on insert, which is exactly what the supersede needs.
///
/// Raw tokens never touch the database — sha256 hash stored, the link
/// carries the token once (`MemberInvite`'s rule). CLASS A: a contact
/// may never read this table, which is why it carries `portal_deny`
/// rather than a gate. Re-inviting SUPERSEDES: the open invitation is
/// marked REVOKED and a new row is minted, so one live token per
/// contact and an old link stops working the moment a new one is sent.
model ContactInvite {
  id                String       @id @default(uuid(7))
  tenantId          String       @map("tenant_id")
  contactId         String       @map("contact_id")
  tokenHash         String       @unique @map("token_hash")
  /// THE ADDRESS THE INVITATION WAS SENT TO, so the token is bound to
  /// it and not merely to the row (SECURITY.md §3.4). `updateContact`
  /// can change a contact's email while an invitation is in flight;
  /// without this, the link mailed to the old address would activate a
  /// contact whose address is now somebody else's, and acceptance would
  /// stamp `emailVerified` for an address nobody proved control of.
  /// Nullable only for rows written before `20260923030000`.
  email             String?
  status            InviteStatus @default(PENDING)
  invitedByMemberId String       @map("invited_by_member_id") // attribution, no FK
  expiresAt         DateTime     @map("expires_at") @db.Timestamptz(6)
  acceptedAt        DateTime?    @map("accepted_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  contact Contact @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, contactId, status])
  @@index([expiresAt])
  @@map("contact_invite")
}

/// GLOBAL seeded catalog; codes are immutable `resource:verb`, from
/// AUTHZ.md §3.1's closed 64-code catalog. module is NOT nullable —
/// core permissions carry the literal "core". requiresMfa is the ✦ set.
model Permission {
  id          String  @id @default(uuid(7))
  code        String  @unique
  description String
  module      String
  requiresMfa Boolean @default(false) @map("requires_mfa")

  rolePermissions RolePermission[]

  @@map("permission")
}

/// Template lineage + drift tracking (B3: tracked-diff-additive) ships
/// in this first migration. templateKey values are canonical:
/// "owner" | "manager" | "admin" | "employee" — AUTHZ.md §7.3 pins the
/// last-owner invariant to templateKey = 'owner'.
model Role {
  id              String   @id @default(uuid(7))
  tenantId        String   @map("tenant_id")
  name            String
  description     String?
  isSystem        Boolean  @default(false) @map("is_system")
  templateKey     String?  @map("template_key")
  clonedFromKey   String?  @map("cloned_from_key")
  templateVersion Int?     @map("template_version")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  rolePermissions RolePermission[]
  memberRoles     MemberRole[]

  @@unique([tenantId, name])
  @@unique([tenantId, id]) // composite-FK target
  @@index([tenantId, templateKey])
  @@map("role")
}

enum RolePermissionSource {
  TEMPLATE
  TENANT_GRANT
  TENANT_REVOKE
}

/// TENANT_REVOKE rows are tombstones: NOT effective, exist so a tenant's
/// deliberate trim survives template propagation. Effective set = rows
/// where source != TENANT_REVOKE. Every change bumps
/// Tenant.permissionsVersion in the same transaction.
model RolePermission {
  tenantId     String               @map("tenant_id")
  roleId       String               @map("role_id")
  permissionId String               @map("permission_id")
  source       RolePermissionSource @default(TENANT_GRANT)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([tenantId, roleId, permissionId])
  @@index([tenantId, permissionId])
  @@map("role_permission")
}

/// Effective permissions = union across held roles (additive-only).
/// Role relation is Restrict: a role still assigned cannot be deleted.
model MemberRole {
  tenantId     String   @map("tenant_id")
  memberId     String   @map("member_id")
  roleId       String   @map("role_id")
  assignedById String?  @map("assigned_by_id") // attribution, no FK
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  member Member @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Cascade)
  role   Role   @relation(fields: [tenantId, roleId], references: [tenantId, id])

  @@id([tenantId, memberId, roleId])
  @@index([tenantId, roleId])
  @@map("member_role")
}

// ───────────────────────────────────────────────────────────────────
// CORE DOMAIN — clients, contacts, assignments, projects (Phase 2)
// DATA_MODEL.md §6.3–§6.6 as amended 2026-08-16. RLS: Client/Contact
// are class B_clientScoped (structural gate — client match only);
// MemberClient/MemberProject class A; Project/ProjectVersion/Milestone/
// Service class B_projectScoped with the trigger-maintained
// portal_enabled column (TENANCY.md §7.2). Composite FKs everywhere.
// ───────────────────────────────────────────────────────────────────

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

enum VatProfile {
  SE_DOMESTIC
  EU_REVERSE_CHARGE
  OUTSIDE_SCOPE
}

/// A customer of a tenant; a company record, never a login. The
/// client-root: its portal_gate is `id = app.client_id` (no client_id
/// column of its own). internalNotes is INTERNAL-ONLY — never selected
/// by any portal projection, never in AuditEvent.metadata.
model Client {
  id                   String       @id @default(uuid(7))
  tenantId             String       @map("tenant_id")
  name                 String
  orgNr                String?      @map("org_nr")
  vatNumber            String?      @map("vat_number")
  vatNumberValidatedAt DateTime?    @map("vat_number_validated_at") @db.Timestamptz(6)
  vatProfile           VatProfile?  @map("vat_profile")
  countryCode          String?      @map("country_code") @db.Char(2)
  addressLine1         String?      @map("address_line1")
  addressLine2         String?      @map("address_line2")
  postalCode           String?      @map("postal_code")
  city                 String?
  billingEmail         String?      @map("billing_email")
  invoiceLocale        String?      @map("invoice_locale")
  status               ClientStatus @default(ACTIVE)
  internalNotes        String?      @map("internal_notes") // INTERNAL-ONLY
  archivedAt           DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  contacts        Contact[]
  memberClients   MemberClient[]
  projects        Project[]
  projectVersions ProjectVersion[]
  milestones      Milestone[]
  services        Service[]
  documents       Document[]
  // 2W:
  workItems          WorkItem[]
  workItemActivities WorkItemActivity[]
  comments           Comment[]
  notifications      Notification[]
  // 2T:
  timeEntries          TimeEntry[]
  projectBudgets       ProjectBudget[]
  projectTimeSummaries ProjectTimeSummary[]
  timeReports          TimeReport[]
  projectUpdates       ProjectUpdate[]
  credentials          CredentialItem[]
  assets               ClientAsset[]
  sealedOpenRequests   SealedOpenRequest[]
  credentialAsks       CredentialAsk[]
  invoices             Invoice[]

  @@unique([tenantId, id]) // composite-FK target for ALL client-scoped children
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@map("client")
}

/// Fixed portal capability profiles (AUTHZ.md §8 is the source of truth
/// for the split). Contacts never enter tenant RBAC.
enum ContactPortalProfile {
  CONTACT_PRIMARY
  CONTACT_COLLABORATOR
}

enum ContactPortalStatus {
  NO_ACCESS
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

/// A person at a client — RECORD ONLY in Phase 2 (portalStatus stays
/// NO_ACCESS). The portal identity stack (ContactSession/Account/
/// Verification, second Better Auth instance) lands in Phase 3 and maps
/// onto the identity columns kept here. Structural class-B row: gated
/// by client match only (no visibility column).
model Contact {
  id            String               @id @default(uuid(7))
  tenantId      String               @map("tenant_id")
  clientId      String               @map("client_id")
  name          String
  email         String               @unique // v1 global (single app domain); (tenantId, email) is the permanent unique
  emailVerified Boolean              @default(false) @map("email_verified")
  image         String?
  title         String?
  phone         String?
  portalProfile ContactPortalProfile @default(CONTACT_COLLABORATOR) @map("portal_profile")
  portalStatus  ContactPortalStatus  @default(NO_ACCESS) @map("portal_status")
  /// LOAD-BEARING SINCE PHASE 3 SLICE 2, not merely a record.
  /// `authorizePortal()` requires this stamp in addition to
  /// `portalStatus = ACTIVE`, which makes invite-only a property of
  /// the ROW rather than only of the codebase (AUTHZ.md §8 glosses it
  /// as "no self-signup path exists in code"). An activation path that
  /// forgets to set it produces a contact that can hold a session and
  /// do nothing — which is the safe direction, and is why it is a
  /// requirement rather than a comment. The invite flow must set it.
  invitedAt     DateTime?            @map("invited_at") @db.Timestamptz(6)
  invitedById   String?              @map("invited_by_id") // Member.id, attribution, no FK
  activatedAt   DateTime?            @map("activated_at") @db.Timestamptz(6)
  locale        String?
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  client Client @relation(fields: [tenantId, clientId], references: [tenantId, id])
  // 2W:
  assignedWorkItems WorkItem[] @relation("WorkItemAssigneeContact")
  // Phase 3 — the invite slice. Cascade: deleting the record takes its
  // invitations with it, as it already takes credentials and sessions.
  portalInvites ContactInvite[]
  // Phase 3 — portal identity. The FKs point INTO a tenant-scoped,
  // RLS-forced table from AUTH-class tables, which is sound: Postgres
  // performs referential-integrity checks as the table owner and they
  // always bypass row security. Cascade is the revocation backstop —
  // deleting the Contact record takes its credentials and live
  // sessions with it.
  //
  // These names are ours to choose, and that was worth MEASURING
  // rather than reading. Credential sign-in calls findUserByEmail(…,
  // {includeAccounts: true}), and @better-auth/prisma-adapter derives
  // an include key for a join by lowercasing the configured model name
  // whole and appending "s" — which for account → ContactAccount reads
  // `contactaccounts`, a name Prisma would have to match exactly. The
  // source says so plainly and the source is not what runs: joins are
  // native only under `experimental.joins`, which this product does not
  // set, so the factory falls back to a SEPARATE query per relation. A
  // probe against the real instance recorded the only two calls the
  // adapter makes on this model, and neither carries a join key:
  //   contact.findFirst {"where":{"email":{"equals":"…"}}}
  //   contact.findFirst {"where":{"id":"…"},"select":{"portalStatus":true}}
  // So: readable names, and if anyone ever turns on experimental joins,
  // measure again before assuming they still are.
  portalAccounts ContactAccount[]
  portalSessions ContactSession[]
  // Phase 3V slice 91 — the client's door to the logins shown to them.
  vaultUnlocks ContactVaultUnlock[]
  // Phase 3V slice 98 — logins the agency asked this person for.
  credentialAsks CredentialAsk[]

  @@unique([tenantId, email])
  @@unique([tenantId, id]) // composite-FK target
  @@index([tenantId, clientId])
  @@map("contact")
}

// ───────────────────────────────────────────────────────────────────
// PORTAL IDENTITY — contact side (Better Auth ≥ 1.6.26, 2nd instance)
// DATA_MODEL.md §6.4. Class AUTH/global: no tenant column, no tenant
// RLS — the auth flow runs before tenant context exists. They are NOT
// a second copy of the member tables: a portal token is rejected on a
// tenant route by TABLE IDENTITY, which is why no `plane` column
// exists here (no other value is representable).
// ───────────────────────────────────────────────────────────────────

/// Portal sessions. Separate cookie name and basePath from the member
/// Session, but the barrier that matters is this table: cookie
/// signatures do NOT bind the cookie's NAME (better-call signs the
/// value alone and both instances share one BETTER_AUTH_SECRET — see
/// src/proxy.ts), so a member session token replayed under the portal
/// cookie name verifies its signature and then finds no row here.
model ContactSession {
  id        String   @id @default(uuid(7))
  token     String   @unique
  contactId String   @map("contact_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([expiresAt])
  @@map("contact_session")
}

/// Portal credentials — the `credential` provider only in v1 (no social
/// login for contacts), which is why the OAuth columns of `account` are
/// absent. That is safe rather than hopeful: every one of them is
/// `required: false` with NO defaultValue in Better Auth's core table
/// (@better-auth/core .../db/get-tables.mjs), and its transformInput
/// SKIPS an undefined field that has no default, so the adapter never
/// names a column that is not here. `updatedAt` likewise has only
/// `onUpdate`, so it is skipped on create and filled by @updatedAt.
/// Rows are created ONLY by invite acceptance — never by a signup
/// endpoint, which does not exist on the portal instance.
model ContactAccount {
  id         String   @id @default(uuid(7))
  contactId  String   @map("contact_id")
  accountId  String   @map("account_id")
  providerId String   @map("provider_id")
  password   String? // scrypt hash, credential provider only
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([contactId])
  @@map("contact_account")
}

/// Portal PASSWORD-RESET tokens, and nothing else: invitation tokens live
/// in ContactInvite, and email verification is a self-contained JWT that
/// writes no row. Since 2026-09-24 the `identifier` is the SHA-256 (base64url)
/// of `reset-password:<token>` — `verification.storeIdentifier: "hashed"` in
/// src/auth/portal.ts — so NOTHING here can be found by building the string
/// yourself: look a token up through the instance's adapter, and purge by
/// `value`, which is the contact id on every row. Before that date this
/// comment said "(hashes)" over rows stored verbatim. Contact MFA is v2, so
/// no ContactTwoFactor table exists.
///
/// NOT cascaded by contact deletion, unlike its two siblings. The columns
/// are Better Auth's generic verification store: `identifier` is derived
/// from a token, and `value` is free-form in the library's other flows
/// (OAuth state keeps JSON there). On THIS instance every row's `value`
/// happens to be a contact id — which is why the purges key on it — but a
/// foreign key would bind a library-owned column to one flow, so it has
/// none, by choice. So an outstanding token OUTLIVES the contact it was
/// issued for. It cannot be redeemed — `value` holds the old uuid, and
/// consuming it resolves to a row that no longer exists — but the
/// "CASCADE is the revocation backstop" note on the other two does not
/// extend here, and the sweep in R4 is what actually clears these.
///
/// `updatedAt` IS REQUIRED and DATA_MODEL.md §6.4's listing omitted it
/// (corrected 2026-09-20). Unlike session/account, Better Auth's
/// `verification.updatedAt` carries a `defaultValue`, so transformInput
/// emits it on EVERY create — against a table without the column the
/// first token written here would have died on an unknown-argument error.
model ContactVerification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@index([expiresAt])
  @@map("contact_verification")
}

/// Explicit member↔client assignment (decision #5, deny-default):
/// scope over the client AND all its projects. Class A.
model MemberClient {
  tenantId     String   @map("tenant_id")
  memberId     String   @map("member_id")
  clientId     String   @map("client_id")
  assignedById String?  @map("assigned_by_id") // attribution, no FK
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  member Member @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Cascade)
  client Client @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, memberId, clientId])
  @@index([tenantId, clientId])
  @@map("member_client")
}

/// Explicit member↔project assignment: scope over that single project
/// and its child records plus the parent client's card (AUTHZ.md §4).
/// Class A.
model MemberProject {
  tenantId     String   @map("tenant_id")
  memberId     String   @map("member_id")
  projectId    String   @map("project_id")
  assignedById String?  @map("assigned_by_id") // attribution, no FK
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  member  Member  @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Cascade)
  project Project @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, memberId, projectId])
  @@index([tenantId, projectId])
  @@map("member_project")
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

/// What the portal hours widget may show (CONTACT_PRIMARY only). Never per-member.
enum HoursSharingMode {
  NONE
  HOURS
  BILLABLE_AMOUNT
}

/// Progress-update cadence (Phase 3); enforced since Phase 5 slice 102 by
/// the reminder job with `Project.updateWeekday` and `updateScheduleSince`.
enum UpdateCadence {
  NONE
  WEEKLY
  BIWEEKLY
  MONTHLY
}

/// Belongs to exactly one Client. key (<= 8 chars, [A-Z][A-Z0-9]*,
/// CHECK in migration) is the human WorkItem prefix ("ACME-12").
/// portalEnabled is THE project-level portal gate: fanned out by
/// trigger to portal_enabled on every projectScoped table; the row's
/// own portal_gate is `client_id = app.client_id AND portal_enabled`
/// (structural row — no visibility column). INTERNAL-ONLY fields
/// (never in a portal projection): repoUrl, hostingNotes, internalNotes,
/// leadMemberId. hostingNotes holds POINTERS only, never secrets.
model Project {
  id                 String           @id @default(uuid(7))
  tenantId           String           @map("tenant_id")
  clientId           String           @map("client_id")
  key                String           @db.VarChar(8)
  name               String
  type               String? // free text — tenant taxonomy
  scopeSummary       String?          @map("scope_summary")
  status             ProjectStatus    @default(PLANNED)
  startDate          DateTime?        @map("start_date") @db.Timestamptz(6)
  launchDate         DateTime?        @map("launch_date") @db.Timestamptz(6)
  productionUrl      String?          @map("production_url")
  stagingUrl         String?          @map("staging_url")
  repoUrl            String?          @map("repo_url") // INTERNAL-ONLY
  hostingNotes       String?          @map("hosting_notes") // INTERNAL-ONLY, pointers only
  internalNotes      String?          @map("internal_notes") // INTERNAL-ONLY
  portalEnabled      Boolean          @default(false) @map("portal_enabled")
  hoursSharingMode   HoursSharingMode @default(NONE) @map("hours_sharing_mode")
  // Phase 3 slice 80 (C47): which parts of the project the client's
  // portal draws — its one-screen page and its card on the home. LAYOUT,
  // not access control: no policy reads them and no child row copies them.
  portalShowTasks      Boolean @default(true) @map("portal_show_tasks")
  portalShowUpdates    Boolean @default(true) @map("portal_show_updates")
  portalShowMilestones Boolean @default(true) @map("portal_show_milestones")
  portalShowFiles      Boolean @default(true) @map("portal_show_files")
  billingCurrency    String?          @map("billing_currency") @db.Char(3)
  defaultBillable    Boolean          @default(true) @map("default_billable")
  leadMemberId       String?          @map("lead_member_id") // Member.id, attribution, no FK
  updateCadence      UpdateCadence    @default(NONE) @map("update_cadence")
  // Phase 5 slice 102 (founder decision C70): the day a progress update is
  // due — ISO 1 = Monday … 5 = Friday (CHECK), Friday by default — and the
  // moment the schedule last (re)started, which ONLY the trigger
  // `project_update_schedule_stamp` writes: on a change of cadence or day,
  // on becoming ACTIVE, on the portal switching on; NULL exactly when the
  // cadence is NONE (CHECK). INTERNAL-ONLY (never in a portal projection).
  updateWeekday       Int              @default(5) @map("update_weekday") @db.SmallInt
  updateScheduleSince DateTime?        @map("update_schedule_since") @db.Timestamptz(6)
  autoArchiveMonths  Int?             @map("auto_archive_months")
  autoStartParent    Boolean          @default(false) @map("auto_start_parent")
  autoCompleteParent Boolean          @default(false) @map("auto_complete_parent")
  defaultServiceId   String?          @map("default_service_id") // 2T (D4): seeds TimeEntry.serviceId; the per-entry picker overrides
  // Phase 5 slice 105 (founder decision C73 (c)): the layout this project's
  // NEW progress updates start from; NULL = the workspace's default layout,
  // else Fortleva standard. INTERNAL-ONLY (never in a portal projection).
  updateTemplateId   String?          @map("update_template_id")
  archivedAt         DateTime?        @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  client         Client           @relation(fields: [tenantId, clientId], references: [tenantId, id])
  memberProjects MemberProject[]
  versions       ProjectVersion[]
  milestones     Milestone[]
  services       Service[]
  documents      Document[]
  // 2W:
  workflowStates     WorkflowState[]
  workItems          WorkItem[]
  workItemActivities WorkItemActivity[]
  labels             Label[]
  comments           Comment[]
  // 2T:
  defaultService Service?             @relation("ProjectDefaultService", fields: [tenantId, defaultServiceId], references: [tenantId, id], onDelete: Restrict)
  timeEntries    TimeEntry[]
  rateCards      RateCard[]
  budgets        ProjectBudget[]
  timeSummaries  ProjectTimeSummary[]
  timeReports    TimeReport[]
  // Phase 3:
  updates        ProjectUpdate[]
  // Phase 5 slice 102:
  updateReminders ProjectUpdateReminderSent[]
  // Phase 5 slice 105 — RESTRICT, as `defaultService`: deleting a layout
  // first points its projects back at the default (update-templates.ts).
  updateTemplate ProjectUpdateTemplate? @relation(fields: [tenantId, updateTemplateId], references: [tenantId, id], onDelete: Restrict)
  // Phase 3V:
  credentials    CredentialItem[]
  assets         ClientAsset[]
  credentialAsks CredentialAsk[]
  // Phase 4:
  invoices       Invoice[]

  @@unique([tenantId, id]) // composite-FK target
  @@unique([tenantId, key])
  @@index([tenantId, clientId, status])
  @@index([tenantId, status])
  @@index([tenantId, updateTemplateId])
  @@map("project")
}

enum ProjectVersionStatus {
  DRAFT
  SHIPPED
}

enum ApprovalStatus {
  NOT_REQUESTED
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

/// What shipped when, with release notes (the version timeline).
/// Structural-status gate (DATA_MODEL.md §6.5): no visibility column —
/// SHIPPED ⇒ client-visible; portal_gate = client match AND
/// status = 'SHIPPED' AND portal_enabled. The four decision columns are
/// CONTACT-writable under RLS since migration 20260927120000 (sign-off).
model ProjectVersion {
  id                  String               @id @default(uuid(7))
  tenantId            String               @map("tenant_id")
  clientId            String               @map("client_id") // denormalised for portal RLS
  projectId           String               @map("project_id")
  version             String
  title               String?
  releaseNotes        String?              @map("release_notes")
  status              ProjectVersionStatus @default(DRAFT)
  shippedAt           DateTime?            @map("shipped_at") @db.Timestamptz(6)
  portalEnabled       Boolean              @default(false) @map("portal_enabled") // trigger-maintained
  approvalStatus      ApprovalStatus       @default(NOT_REQUESTED) @map("approval_status")
  approvalRequestedAt DateTime?            @map("approval_requested_at") @db.Timestamptz(6)
  approvalDecidedAt   DateTime?            @map("approval_decided_at") @db.Timestamptz(6)
  approvalByContactId String?              @map("approval_by_contact_id") // attribution, no FK
  approvalNote        String?              @map("approval_note")
  createdByMemberId   String?              @map("created_by_member_id") // attribution, no FK
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  client         Client     @relation(fields: [tenantId, clientId], references: [tenantId, id])
  project        Project    @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  fixedWorkItems WorkItem[]

  @@unique([tenantId, projectId, version])
  @@unique([tenantId, id]) // composite-FK target (WorkItem.fixedInVersionId)
  @@index([tenantId, clientId, shippedAt])
  @@map("project_version")
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  DONE
  CANCELLED
}

/// The agency "phase" unit. rank is text COLLATE "C" (fractional-
/// indexing; the collation is applied in the migration SQL — Prisma
/// cannot express it). Carries visibility like every content row.
model Milestone {
  id            String          @id @default(uuid(7))
  tenantId      String          @map("tenant_id")
  clientId      String          @map("client_id") // denormalised for portal RLS
  projectId     String          @map("project_id")
  name          String
  description   String?
  status        MilestoneStatus @default(PLANNED)
  dueAt         DateTime?       @map("due_at") @db.Timestamptz(6)
  completedAt   DateTime?       @map("completed_at") @db.Timestamptz(6)
  rank          String // text COLLATE "C" (migration SQL)
  visibility    Visibility      @default(INTERNAL)
  portalEnabled Boolean         @default(false) @map("portal_enabled") // trigger-maintained
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  client    Client     @relation(fields: [tenantId, clientId], references: [tenantId, id])
  project   Project    @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  workItems WorkItem[]

  @@unique([tenantId, id]) // composite-FK target (WorkItem.milestoneId)
  @@unique([tenantId, projectId, rank])
  @@index([tenantId, clientId, visibility])
  @@map("milestone")
}

enum ServiceKind {
  ONE_TIME
  RECURRING
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ServiceStatus {
  ACTIVE
  PAUSED
  ENDED
}

/// Progress-update health — HUMAN-CHOSEN, never computed (DATA_MODEL.md
/// §6.16): a computed health is either wrong or ignored, so the machine
/// numbers sit NEXT to it on the frozen snapshot instead.
enum ProjectHealth {
  ON_TRACK
  AT_RISK
  OFF_TRACK
  ON_HOLD
  COMPLETE

  @@map("project_health")
}

enum ProjectUpdateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED // archive-only; a published update is never deleted

  @@map("project_update_status")
}

/// ProjectUpdate — one status post, the portal centrepiece (§6.16;
/// Phase 3; rides on entitlement `work`, `project_update:*`). A human
/// picks the health; the machine fills the metrics at PUBLISH and freezes
/// them: `portalSnapshot` holds only portal-safe aggregates (tasks done /
/// total, milestones, versions, requests, hours only when the project
/// shares them), and everything per-member or cost-shaped lives on the
/// class-A `ProjectUpdateInternalSnapshot` so it never sits on a row a
/// contact can select. `seq` is allocated at publish from
/// counters.next("project_update:<projectId>") — a draft has none.
/// body Json = { sections: [{ key SUMMARY|DONE|NEXT|BLOCKERS|
/// DECISIONS_NEEDED|CUSTOM, title?, body Tiptap }], metrics: { include } }.
/// IMMUTABLE AFTER PUBLISH (trigger project_update_immutable): only
/// status (PUBLISHED → ARCHIVED), visibility, editNote, pdfDocumentId and
/// the stamped columns may change — except that within FIFTEEN MINUTES of
/// publishing the post may be RETRACTED to DRAFT, giving up its number,
/// its snapshots and its audience (§6.16's grace window; the service and
/// the trigger enforce the same clock). Archiving hides it from the
/// portal (visibility → INTERNAL; CHECK visible_only_published).
/// portal_gate is the FOUR-term form: + status = 'PUBLISHED', so a draft
/// is unreachable by a contact whatever its visibility says.
/// scope=client  rls=B (projectScoped; + status = PUBLISHED)  ret=R2  enc=none
/// audit: project_update.published | archived | visibility_changed |
///        retracted | annotated | draft_discarded
model ProjectUpdate {
  id                  String              @id @default(uuid(7))
  tenantId            String              @map("tenant_id")
  clientId            String              @map("client_id") // denormalised for portal RLS
  projectId           String              @map("project_id")
  seq                 Int? // counters.next("project_update:<projectId>") at PUBLISH; NULL on a draft (CHECK)
  health              ProjectHealth // human-chosen; the composer's first control
  title               String?             @db.VarChar(200)
  periodStart         DateTime?           @map("period_start") @db.Date
  periodEnd           DateTime?           @map("period_end") @db.Date
  body                Json // { sections, metrics }
  bodyText            String?             @map("body_text") // extracted plain text (digest, a later search feed)
  portalSnapshot      Json?               @map("portal_snapshot") // portal-safe metrics frozen at publish; NULL on a draft (CHECK)
  changesSinceLast    Json?               @map("changes_since_last") // ids only — the pull-in panel's source, staff rendering
  status              ProjectUpdateStatus @default(DRAFT)
  visibility          Visibility          @default(INTERNAL) // the publish dialog asks; INTERNAL unless PUBLISHED (CHECK)
  portalEnabled       Boolean             @default(false) @map("portal_enabled") // trigger-maintained
  authorMemberId      String              @map("author_member_id") // attribution, no FK
  publishedAt         DateTime?           @map("published_at") @db.Timestamptz(6)
  publishedByMemberId String?             @map("published_by_member_id") // attribution, no FK
  editNote            String?             @map("edit_note") @db.VarChar(500) // a note added AFTER publish — the one text that may change
  pdfDocumentId       String?             @map("pdf_document_id") // → Document(kind REPORT); reserved, nothing writes it yet
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant                         @relation(fields: [tenantId], references: [id])
  client           Client                         @relation(fields: [tenantId, clientId], references: [tenantId, id])
  project          Project                        @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  internalSnapshot ProjectUpdateInternalSnapshot?

  @@unique([tenantId, id]) // composite-FK target
  @@unique([tenantId, projectId, seq])
  @@index([tenantId, projectId, status, publishedAt(sort: Desc)])
  @@index([tenantId, clientId, visibility, publishedAt(sort: Desc)]) // portal + timeline
  @@map("project_update")
}

/// ProjectUpdateInternalSnapshot — 1:1 with a PUBLISHED ProjectUpdate,
/// CLASS A: the per-member hours, the cost/margin and the budget burn the
/// composer shows staff, frozen at publish beside portalSnapshot. Cost
/// figures are present only when the publisher held rate:view_cost ✦
/// with a recent factor at publish time (else NULL — never back-filled),
/// and every part is gated on READ by the code that gates its live
/// source (time:view_team, rate:view_cost ✦, budget:view). Deleted with
/// its update, and by a retraction.
/// scope=tenant  rls=A (principalScoped)  ret=R2  enc=none (aggregates only)
model ProjectUpdateInternalSnapshot {
  updateId   String   @id @map("update_id")
  tenantId   String   @map("tenant_id")
  byMember   Json?    @map("by_member") // [{ memberId, seconds, billableSeconds }]
  cost       Json?    // { inPeriod, toDate, margin, marginPercent, currency } — NULL unless rate:view_cost at publish
  budget     Json?    // { kind, amount, currency, used, usedPercent, periodKey }
  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  update ProjectUpdate @relation(fields: [tenantId, updateId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, updateId])
  @@map("project_update_internal_snapshot")
}

/// ProjectUpdateReminderSent — class A, the progress-update reminders'
/// dedupe (Phase 5 slice 102; founder decision C70; DATA_MODEL.md §6.16's
/// `ProjectUpdateSchedule`, built as the project's two columns above plus
/// this). One row per reminder that went out: the project, the scheduled
/// DAY whose round it belongs to and the step (0 that day, 1 and 2 the
/// working days after). The primary key IS the dedupe — the job INSERTs …
/// ON CONFLICT DO NOTHING in the transaction that writes the inbox rows and
/// the audit row, and a conflict means "already sent". Deleted with its
/// project (FK cascade) and by the job's own sweep 60 days after its day.
/// scope=tenant  rls=A (portal_deny)  ret=60 days, or with the project (FK cascade)  enc=none
model ProjectUpdateReminderSent {
  tenantId  String   @map("tenant_id")
  projectId String   @map("project_id")
  dueOn     DateTime @map("due_on") @db.Date // the round's day, in the workspace's zone
  step      Int      @db.SmallInt // 0 | 1 | 2 (CHECK)
  sentAt    DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  project Project @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, projectId, dueOn, step])
  @@index([tenantId, dueOn]) // the sweep
  @@map("project_update_reminder_sent")
}

/// ProjectUpdateTemplate — class A, a workspace's named LAYOUT for new
/// progress updates (Phase 5 slice 105; founder decision C73 (c), (d), (g);
/// DATA_MODEL.md §6.16). `sections` is the ordered list of headings a new
/// update opens with — `[{ "key": "SUMMARY" } | { "key": "CUSTOM", "title":
/// "…" }, …]`: each of the five fixed keys at most once, DONE always (C73
/// (g)), at most three CUSTOM with distinct titles, eight in all;
/// `metricsIncluded` is which numbers start ticked (`{ tasks, milestones,
/// versions, requests, hours }`). The app validates both on write and on
/// read (`src/modules/work/update-layout.ts`); the CHECKs hold the outline.
/// At most one per tenant `isDefault` (partial UNIQUE); with none, the
/// default is Fortleva standard. Names unique per tenant, case-insensitively
/// (an expression UNIQUE in the migration). Edited under `settings:edit`.
/// A layout is copied into an update when it is written: editing or
/// deleting it never changes a draft or a post.
/// scope=tenant  rls=A (portal_deny)  ret=with the tenant  enc=none
/// audit: project_update_template.created|updated|deleted|default_changed
model ProjectUpdateTemplate {
  id              String   @id @default(uuid(7))
  tenantId        String   @map("tenant_id")
  name            String
  sections        Json
  metricsIncluded Json     @map("metrics_included")
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  projects Project[]

  @@unique([tenantId, id]) // composite-FK target
  @@map("project_update_template")
}

/// What the client buys — a RECORD with renewal dates, not a billing
/// engine. projectId optional: portal_enabled is trigger-maintained
/// (TRUE when projectId is NULL, so the two-term client gate applies
/// in effect; else the project's switch). internalNotes INTERNAL-ONLY.
model Service {
  id              String           @id @default(uuid(7))
  tenantId        String           @map("tenant_id")
  clientId        String           @map("client_id")
  projectId       String?          @map("project_id")
  name            String
  description     String?
  kind            ServiceKind
  billingInterval BillingInterval? @map("billing_interval")
  priceExVat      Decimal?         @map("price_ex_vat") @db.Decimal(12, 2)
  currency        String?          @db.Char(3)
  status          ServiceStatus    @default(ACTIVE)
  startedAt       DateTime?        @map("started_at") @db.Timestamptz(6)
  renewsAt        DateTime?        @map("renews_at") @db.Timestamptz(6)
  endsAt          DateTime?        @map("ends_at") @db.Timestamptz(6)
  internalNotes   String?          @map("internal_notes") // INTERNAL-ONLY
  visibility      Visibility       @default(INTERNAL)
  portalEnabled   Boolean          @default(false) @map("portal_enabled") // trigger-maintained
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  client  Client   @relation(fields: [tenantId, clientId], references: [tenantId, id])
  project Project? @relation(fields: [tenantId, projectId], references: [tenantId, id])
  // 2T (D4 — the Service IS the agreement):
  defaultForProjects Project[]   @relation("ProjectDefaultService")
  rateCards          RateCard[]
  timeEntries        TimeEntry[]

  @@unique([tenantId, id]) // composite-FK target (InvoiceLine.serviceId)
  @@index([tenantId, clientId, status])
  @@index([tenantId, renewsAt])
  @@index([tenantId, projectId]) // portal fan-out + the FK — 20260920190000
  @@map("service")
}

// ───────────────────────────────────────────────────────────────────
// INVOICING (Phase 4 — DATA_MODEL.md §6.7, §9; founder decision C75).
// Slice 107: drafts. An invoice is a DRAFT (no number, edited freely,
// deletable) until it is ISSUED, then never changes — `invoice_guard` and
// `invoice_line_guard` in migration 20261009120000 hold it. Both tables are
// class A until slice 109 builds the client's view.
// Slice 108: issuing (migration 20261009200000) — the number, allocated by
// the guard from the workspace's ONE series; the parties' snapshots, written
// by the guard; VAT in SEK on another currency; the PDF, recorded once.
// ───────────────────────────────────────────────────────────────────

/// The workspace's invoice numbers (founder decision C76 (a)–(c)): ONE series,
/// plain numbers counting up from `firstNumber` and never restarting; credit
/// notes draw from it too. `nextNumber` is a counter ROW (never a SEQUENCE —
/// a rolled-back issue gives its number back): only the issue guard moves it,
/// one step per issued invoice; the first number may be changed only while
/// `nextNumber = firstNumber` (`invoice_series_guard`).
model InvoiceSeries {
  id                String   @id @default(uuid(7))
  tenantId          String   @unique @map("tenant_id") // one series per workspace (C76)
  firstNumber       Int      @map("first_number")
  nextNumber        Int      @map("next_number")
  createdByMemberId String   @map("created_by_member_id") // attribution, no FK
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  invoices Invoice[]

  @@unique([tenantId, id]) // composite-FK target
  @@map("invoice_series")
}

enum InvoiceKind {
  INVOICE
  CREDIT_NOTE // corrections happen ONLY via credit notes (slice 108)

  @@map("invoice_kind")
}

enum InvoiceStatus {
  DRAFT // no number, editable, deletable
  ISSUED // number allocated, content frozen
  SENT
  PAID
  CREDITED

  @@map("invoice_status")
}

/// An invoice. A DRAFT reads its client live; issuing (slice 108) freezes
/// everything. The totals are NULL on a draft (computed on read from the
/// lines by `src/modules/invoicing/money.ts`) and, once issued, equal to
/// what the lines say — the guard checks it.
model Invoice {
  id                String        @id @default(uuid(7))
  tenantId          String        @map("tenant_id")
  clientId          String        @map("client_id")
  projectId         String?       @map("project_id")
  kind              InvoiceKind   @default(INVOICE)
  creditsInvoiceId  String?       @map("credits_invoice_id") // CREDIT_NOTE → the invoice it credits
  status            InvoiceStatus @default(DRAFT)
  seriesId          String?       @map("series_id") // set at issue (slice 108)
  number            Int? // allocated at issue BY THE GUARD; NULL while DRAFT
  displayNumber     String?       @map("display_number") // the number as text (C76 (a): plain digits)
  vatProfile        VatProfile    @map("vat_profile")
  locale            String? // "sv" | "en": NULL on a draft follows the client (C76 (e)); fixed at issue
  currency          String        @db.Char(3)
  paymentTermsDays  Int           @map("payment_terms_days")
  periodStart       DateTime?     @map("period_start") @db.Date
  periodEnd         DateTime?     @map("period_end") @db.Date
  buyerReference    String?       @map("buyer_reference") // "Er referens" (EN 16931 BT-10)
  ourReference      String?       @map("our_reference") // "Vår referens"
  note              String? // printed on this invoice only
  issueDate         DateTime?     @map("issue_date") @db.Date
  dueDate           DateTime?     @map("due_date") @db.Date
  issuedAt          DateTime?     @map("issued_at") @db.Timestamptz(6)
  issuedByMemberId  String?       @map("issued_by_member_id") // attribution, no FK
  subtotalExVat     Decimal?      @map("subtotal_ex_vat") @db.Decimal(16, 2)
  vatTotal          Decimal?      @map("vat_total") @db.Decimal(16, 2)
  total             Decimal?      @db.Decimal(16, 2)
  // Slice 108 — written at issue, frozen after. The three snapshots are
  // BUILT BY THE GUARD from the tenant and client rows (the app's values are
  // overwritten); `paymentSnapshot` holds the tenant's bank-column v2
  // CIPHERTEXTS copied verbatim (decrypt under the tenant row's AAD).
  sellerSnapshot    Json?         @map("seller_snapshot")
  paymentSnapshot   Json?         @map("payment_snapshot")
  buyerSnapshot     Json?         @map("buyer_snapshot")
  fxRateToSek       Decimal?      @map("fx_rate_to_sek") @db.Decimal(12, 6) // SEK per unit, the ECB's (only with VAT in another currency)
  fxRateDate        DateTime?     @map("fx_rate_date") @db.Date
  vatTotalSek       Decimal?      @map("vat_total_sek") @db.Decimal(16, 2)
  pdfFileId         String?       @map("pdf_file_id") // the archived rendering, recorded once after issue
  // Slice 108b — a credit note says WHY (C77 (b)): required to issue one,
  // NULL on an invoice (CHECKs). Its amounts are stored POSITIVE, as an
  // invoice's; the print negates them (C77 (a); `print.ts`'s `signed`).
  creditReason      String?       @map("credit_reason")
  // …and what it credits, by number and date — WRITTEN BY THE GUARD at issue
  // from the original (ML's unambiguous reference, in the record itself).
  creditsDisplayNumber String?    @map("credits_display_number")
  creditsIssueDate  DateTime?     @map("credits_issue_date") @db.Date
  // Slice 109 — sending, the client's portal, Pay now (C79). The pay link is
  // a draft's (an INVOICE's only), frozen at issue with everything else, and
  // only Stripe's or PayPal's own hosts (CHECK + `src/config`'s `payLinkUrl`).
  // `sentAt` is the FIRST send (emailed or marked) and the portal's gate;
  // `paidOn` the day a payment marked by hand arrived (C79 (d)). The agency's
  // NOTE on that payment is NOT here: this row is a client's to read once sent
  // (class B), so the note lives on a class-A row (`InvoicePaymentNote`).
  payLinkUrl        String?       @map("pay_link_url")
  sentAt            DateTime?     @map("sent_at") @db.Timestamptz(6)
  paidOn            DateTime?     @map("paid_on") @db.Date
  createdByMemberId String        @map("created_by_member_id") // attribution, no FK
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  client      Client         @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  project     Project?       @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  credits     Invoice?       @relation("InvoiceCredits", fields: [tenantId, clientId, creditsInvoiceId], references: [tenantId, clientId, id], onDelete: NoAction, onUpdate: NoAction)
  creditNotes Invoice[]      @relation("InvoiceCredits")
  lines       InvoiceLine[]
  deliveries  InvoiceDelivery[]
  paymentNote InvoicePaymentNote?
  series      InvoiceSeries? @relation(fields: [tenantId, seriesId], references: [tenantId, id], onDelete: Restrict)
  pdfFile     FileObject?    @relation(fields: [tenantId, pdfFileId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id]) // composite-FK target
  @@unique([tenantId, clientId, id]) // the line's FK: its client is its invoice's
  @@unique([tenantId, seriesId, number]) // the gap-free series' backstop (slice 108)
  @@unique([tenantId, pdfFileId]) // one PDF belongs to one invoice
  @@index([tenantId, clientId, status])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, projectId])
  @@index([tenantId, creditsInvoiceId])
  @@map("invoice")
}

/// A line. Its amount is quantity × unit price, to the öre (CHECK); its VAT
/// rate one its invoice's VAT treatment allows (`invoice_line_guard`).
/// `clientId` is its invoice's (composite FK). Class A even after slice 109:
/// the client's copy of the lines is the PDF, never these rows.
model InvoiceLine {
  id             String   @id @default(uuid(7))
  tenantId       String   @map("tenant_id")
  clientId       String   @map("client_id")
  invoiceId      String   @map("invoice_id")
  position       Int
  description    String
  quantity       Decimal  @db.Decimal(12, 3)
  unit           String?
  unitPriceExVat Decimal  @map("unit_price_ex_vat") @db.Decimal(14, 2)
  vatRatePct     Decimal  @map("vat_rate_pct") @db.Decimal(5, 2)
  amountExVat    Decimal  @map("amount_ex_vat") @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [tenantId, clientId, invoiceId], references: [tenantId, clientId, id], onDelete: Cascade)

  @@unique([tenantId, id]) // composite-FK target (time_entry.invoice_line_id, step 4)
  @@unique([tenantId, invoiceId, position])
  @@index([tenantId, clientId, invoiceId])
  @@map("invoice_line")
}

enum InvoiceDeliveryMethod {
  EMAIL // emailed by Fortleva with its PDF attached (C79 (a))
  MARKED // "Mark as sent" — sent some other way

  @@map("invoice_delivery_method")
}

/// One send of an issued invoice or credit note (Phase 4 slice 109; C79):
/// emailed — to whom, the addresses that took it — or marked as sent, by whom,
/// when. Written only by a member holding `invoice:send` (its guard), never
/// changed; class A — the agency's record, never the client's.
model InvoiceDelivery {
  id             String                @id @default(uuid(7))
  tenantId       String                @map("tenant_id")
  clientId       String                @map("client_id")
  invoiceId      String                @map("invoice_id")
  method         InvoiceDeliveryMethod
  recipients     String[] // EMAIL: 1–3 lower-cased addresses; MARKED: none
  sentByMemberId String                @map("sent_by_member_id") // attribution, no FK
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [tenantId, clientId, invoiceId], references: [tenantId, clientId, id], onDelete: Cascade)

  @@index([tenantId, invoiceId, createdAt])
  @@index([tenantId, createdAt]) // the sending budget's count
  @@map("invoice_delivery")
}

/// The agency's own note on a payment marked by hand (Phase 4 slice 109; C79
/// (d)) — "USD 15 short, bank fee", the bank's reference. Its own CLASS-A row
/// because the invoice is a client's to read once sent (the pre-apply
/// migration review's medium: a projection's select is not a database rule).
/// One per invoice while it is PAID (or CREDITED after being paid): written
/// beside the move to PAID, deleted by "Mark as unpaid", never changed
/// (`invoice_payment_note_guard`).
model InvoicePaymentNote {
  tenantId          String   @map("tenant_id")
  clientId          String   @map("client_id")
  invoiceId         String   @map("invoice_id")
  note              String
  createdByMemberId String   @map("created_by_member_id") // attribution, no FK
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [tenantId, clientId, invoiceId], references: [tenantId, clientId, id], onDelete: Cascade)

  @@id([tenantId, clientId, invoiceId]) // one per invoice (the relation's fields: one-to-one)
  @@map("invoice_payment_note")
}

// ───────────────────────────────────────────────────────────────────
// DOCUMENTS & FILES (file bytes live in R2 EU; DB holds metadata)
// ───────────────────────────────────────────────────────────────────

enum Visibility {
  INTERNAL // THE DEFAULT, everywhere — worst-bug guard (§5)
  CLIENT_VISIBLE
}

enum AttachableType {
  CLIENT
  PROJECT
  PROJECT_VERSION
  MILESTONE
  SERVICE
  CONTRACT
  INVOICE
  ISSUE // DEPRECATED — never used; new anchors use WORK_ITEM (enum stays additive)
  WORK_ITEM // 2W
  COMMENT // 2W
  PROJECT_UPDATE // Phase 3
  CREDENTIAL // 3V — non-secret attachments only
  ASSET // 3V
}

/// Drives the portal "Files & deliverables" grouping, the Client
/// Timeline and the approval flow (DELIVERABLE only, Phase 3).
enum DocumentKind {
  GENERAL
  DELIVERABLE
  REPORT
  EXPORT
}

/// clientId nullable = tenant-internal. CHECK constraint in migration:
/// CLIENT_VISIBLE requires clientId. Composite FKs to Client/Project.
/// (attachedToType, attachedToId) is a presentation anchor —
/// authorization never traverses it.
/// portalEnabled (class B_projectScoped, TENANCY.md §7.2) is trigger-
/// maintained, never written by the app: TRUE when projectId is NULL
/// (a client-level document has no project switch to honour), else the
/// project's portalEnabled. The portal_gate ANDs it in.
model Document {
  id                 String          @id @default(uuid(7))
  tenantId           String          @map("tenant_id")
  clientId           String?         @map("client_id")
  projectId          String?         @map("project_id")
  name               String
  kind               DocumentKind    @default(GENERAL)
  tags               String[]        @default([])
  visibility         Visibility      @default(INTERNAL)
  portalEnabled      Boolean         @default(false) @map("portal_enabled") // trigger-maintained
  attachedToType     AttachableType? @map("attached_to_type")
  attachedToId       String?         @map("attached_to_id")
  // Sign-off, v1-lite (DATA_MODEL.md §6.8, Phase 3): mirrors ProjectVersion's
  // block; the four decision columns are CONTACT-writable under RLS on a
  // DELIVERABLE (migration 20260927120000). `approvalVersionNumber` is the
  // FileVersion the ask was about, stamped by staff at request time.
  approvalStatus        ApprovalStatus @default(NOT_REQUESTED) @map("approval_status")
  approvalRequestedAt   DateTime?      @map("approval_requested_at") @db.Timestamptz(6)
  approvalDecidedAt     DateTime?      @map("approval_decided_at") @db.Timestamptz(6)
  approvalByContactId   String?        @map("approval_by_contact_id") // attribution, no FK
  approvalNote          String?        @map("approval_note")
  approvalVersionNumber Int?           @map("approval_version_number")
  createdByMemberId  String?         @map("created_by_member_id") // attribution, no FK
  createdByContactId String?         @map("created_by_contact_id") // attribution, no FK
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  client   Client?       @relation(fields: [tenantId, clientId], references: [tenantId, id])
  project  Project?      @relation(fields: [tenantId, projectId], references: [tenantId, id])
  versions FileVersion[]

  @@unique([tenantId, id])
  @@index([tenantId, clientId, visibility])
  @@index([tenantId, projectId, kind])
  @@index([tenantId, attachedToType, attachedToId])
  // Composite GIN needs the btree_gin extension (created in migration 001)
  @@index([tenantId(ops: raw("text_ops")), tags], type: Gin)
  @@map("document")
}

/// Current version = max versionNumber. The portal never queries this
/// layer — downloads resolve through Document's visibility check.
model FileVersion {
  id                  String   @id @default(uuid(7))
  tenantId            String   @map("tenant_id")
  documentId          String   @map("document_id")
  versionNumber       Int      @map("version_number")
  fileObjectId        String   @map("file_object_id")
  note                String?
  uploadedByMemberId  String?  @map("uploaded_by_member_id") // attribution, no FK
  uploadedByContactId String?  @map("uploaded_by_contact_id") // attribution, no FK
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document   Document   @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Cascade)
  fileObject FileObject @relation(fields: [tenantId, fileObjectId], references: [tenantId, id])

  @@unique([tenantId, documentId, versionNumber])
  @@index([tenantId, fileObjectId])
  @@map("file_version")
}

enum FileObjectStatus {
  PENDING
  COMMITTED
  DELETED
}

enum ScanStatus {
  UNSCANNED
  CLEAN
  INFECTED
}

enum FileKind {
  GENERAL
  INVOICE_PDF
  CONTRACT_PDF
  SIGNATURE_EVIDENCE
  THUMBNAIL
  EXPORT
}

/// One immutable blob in R2 (key: {tenantId}/{fileObjectId}). sizeBytes
/// is THE quota-metering unit; PENDING reserves quota, HEAD-verify then
/// COMMITTED + Tenant.storageUsedBytes increment in one transaction.
model FileObject {
  id                 String           @id @default(uuid(7))
  tenantId           String           @map("tenant_id")
  r2Key              String           @unique @map("r2_key")
  kind               FileKind         @default(GENERAL)
  sha256             String
  sizeBytes          BigInt           @map("size_bytes")
  contentType        String           @map("content_type") // server-side allowlist
  originalFilename   String?          @map("original_filename")
  status             FileObjectStatus @default(PENDING)
  scanStatus         ScanStatus       @default(UNSCANNED) @map("scan_status")
  createdByMemberId  String?          @map("created_by_member_id") // attribution, no FK
  createdByContactId String?          @map("created_by_contact_id") // attribution, no FK
  committedAt        DateTime?        @map("committed_at") @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  versions FileVersion[]
  invoices Invoice[] // the invoice an INVOICE_PDF archives (slice 108)

  @@unique([tenantId, id]) // composite-FK target
  @@index([tenantId, status])
  @@index([tenantId, sha256])
  @@index([tenantId, kind])
  @@map("file_object")
}

// ───────────────────────────────────────────────────────────────────
// AUDIT
// ───────────────────────────────────────────────────────────────────

enum ActorType {
  MEMBER
  CONTACT
  PLATFORM_ADMIN
  SYSTEM
}

enum AuditVisibility {
  TENANT
  PLATFORM
}

/// Append-only (runtime role: INSERT+SELECT only + guard trigger).
/// NO foreign keys by design — rows survive their actors, targets and
/// (for PLATFORM events) the tenant. createdAt is DB now(), never
/// app-supplied. metadata is minimized: never plaintext of encrypted
/// fields, never document contents, never personnummer.
model AuditEvent {
  id             String          @id @default(uuid(7))
  tenantId       String?         @map("tenant_id") // NULL = platform-plane event
  actorType      ActorType       @map("actor_type")
  actorId        String?         @map("actor_id")
  impersonatorId String?         @map("impersonator_id")
  action         String // static catalog, "entity.verb"
  targetType     String?         @map("target_type")
  targetId       String?         @map("target_id")
  metadata       Json?
  requestId      String?         @map("request_id")
  ip             String?
  userAgent      String?         @map("user_agent")
  visibility     AuditVisibility
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, targetType, targetId])
  @@index([actorType, actorId, createdAt(sort: Desc)])
  @@index([requestId])
  @@map("audit_event")
}

// ───────────────────────────────────────────────────────────────────
// WORK (Phase 2W) — module `work` (DATA_MODEL.md §6.14)
// One generic WorkItem (UI word "Task"; Epic → Task → Subtask) with
// tenant-named states inside fixed categories, one fractional rank,
// field-level activity, polymorphic comments, labels, templates.
// Every constraint Prisma cannot express (CHECKs, COLLATE "C",
// parent/state/visibility triggers, portal policies) is hand-written
// in the 2W migration; each has a data-layer test.
// NOTE: search_index (§6.19) is deliberately NOT a Prisma model —
// generated tsvector + regconfig columns are hand-written DDL; the app
// reads it via $queryRaw in src/search/ only.
// ───────────────────────────────────────────────────────────────────

/// Fixed categories. Tenants name their states; the category of a
/// state is immutable (trigger). Rollups, the portal and the state
/// machine read ONLY the category. TRIAGE = landing zone for
/// kind=REQUEST; one hidden Triage state auto-created per project.
enum StateCategory {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
  TRIAGE

  @@map("state_category")
}

/// Which seeded default a state STARTED as — the durable identity that
/// survives the fact that a name can be renamed (DATA_MODEL §6.14,
/// amended 2026-09-01). NULL means a state the tenant created itself.
/// NOT derivable from StateCategory: seven keys against six categories,
/// because the IN_PROGRESS category carries TWO seeded defaults (In
/// progress, then In review — 2W-R) while every other carries one.
enum StateSeedKey {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
  TRIAGE

  @@map("state_seed_key")
}

/// Per-project named states. NAMING, amended 2026-09-01 (DATA_MODEL
/// §6.14 is the authority): translate-until-renamed. A seeded state
/// stores NO name and renders its `seedKey` through i18n in the VIEWER's
/// language; writing a name makes it plain tenant text, forever. The
/// live seeding path is the LAZY ensureProjectStates (states.ts), not a
/// preset copy. Class A — the portal never joins this table; it reads
/// WorkItem.stateCategory only (P10).
model WorkflowState {
  id               String        @id @default(uuid(7))
  tenantId         String        @map("tenant_id")
  projectId        String        @map("project_id")
  /// NULL = still wearing its seeded default, so it renders through i18n
  /// in the VIEWER's language (resolve with `seedKey`). Any non-NULL
  /// value is plain TENANT TEXT and is never translated again — writing
  /// a name IS the rename. One-way is enforced by the WRITE PATH, not by
  /// the schema — `SET name = NULL` returns a state to translate-mode, so
  /// the future state editor must refuse to clear a name. Existing
  /// projects keep their stored names until opted in. (§6.14, 2026-09-01.)
  name             String?
  seedKey          StateSeedKey? @map("seed_key")
  color            String?
  category         StateCategory // IMMUTABLE after insert (trigger)
  rank             String // text COLLATE "C" (migration SQL) — column order
  isDefault        Boolean       @default(false) @map("is_default") // where new items land (exactly one per project — service)
  isHidden         Boolean       @default(false) @map("is_hidden") // TRIAGE hidden until it has items
  wipLimit         Int?          @map("wip_limit") // stored; soft warning only in v1
  requiresApproval Boolean       @default(false) @map("requires_approval") // entering needs work_item:approve ON TOP of work_item:edit (2W-R; seeded true on Done)
  definitionOfDone String?       @map("definition_of_done") // v1.5 UI; column reserved
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  project   Project    @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  workItems WorkItem[]

  @@unique([tenantId, projectId, name]) // NULLs do not collide — untouched seeds are all NULL
  @@unique([tenantId, projectId, seedKey]) // one of each default per project; also what makes the lazy seed's skipDuplicates race-safe now that names are NULL
  @@unique([tenantId, projectId, rank])
  @@unique([tenantId, id]) // composite-FK target (WorkItem.stateId)
  @@index([tenantId, projectId, category])
  @@map("workflow_state")
}

/// Tenant-editable named state sets, copied into each new project.
/// states Json = [{name, color, category, rank, isDefault}]. The seed
/// ships one preset per tenant (locale-aware names at provisioning;
/// tenant text after that — never re-translated).
model WorkflowPreset {
  id        String   @id @default(uuid(7))
  tenantId  String   @map("tenant_id")
  name      String
  states    Json
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("workflow_preset")
}

/// The three levels. UI: Epic / Task / Subtask. No "Feature" level.
enum WorkItemType {
  EPIC // depth 0 only
  TASK // depth 0 or 1
  SUBTASK // depth 1 or 2

  @@map("work_item_type")
}

/// What the row is about; orthogonal to type. REQUEST = portal/email-
/// submitted, starts in the TRIAGE-category state (absorbs Issue).
enum WorkItemKind {
  TASK
  BUG
  REQUEST

  @@map("work_item_kind")
}

enum WorkItemPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("work_item_priority")
}

/// Triage outcome for kind=REQUEST (and anything parked in TRIAGE).
enum TriageStatus {
  PENDING
  ACCEPTED
  DECLINED
  SNOOZED
  DUPLICATE

  @@map("triage_status")
}

enum WorkItemSource {
  IN_APP
  PORTAL // brokered contact write (system principal after authorizePortal)
  EMAIL // Phase 5+, behind entitlement work.email_intake
  IMPORT // ImportJob (Phase 6)

  @@map("work_item_source")
}

/// THE table (UI word "Task"). Denormalised on purpose — each column
/// is load-bearing for RLS or flat rollups: clientId (portal_gate),
/// stateCategory (portal reads it, never workflow_state), rootId/depth
/// (flat GROUP BY replaces recursive CTEs), checklist counters,
/// portalEnabled (trigger-maintained). Single assignee member XOR
/// contact (CHECK); contact assignee forces CLIENT_VISIBLE (CHECK).
/// Child <= parent visibility + downgrade refusal + depth/type/state
/// sync + cross-project-move refusal: triggers in the 2W migration.
model WorkItem {
  id                  String           @id @default(uuid(7))
  tenantId            String           @map("tenant_id")
  clientId            String           @map("client_id") // denormalised from project — RLS predicate
  projectId           String           @map("project_id")
  number              Int // counters.next("work_item:<projectId>") — display "<Project.key>-<number>"
  type                WorkItemType     @default(TASK)
  kind                WorkItemKind     @default(TASK)
  title               String
  description         Json? // Tiptap ProseMirror JSON (checklist = taskList nodes)
  descriptionText     String?          @map("description_text") // extracted plain text (search feed, previews)
  stateId             String           @map("state_id")
  stateCategory       StateCategory    @map("state_category") // DENORMALISED — the only state field the portal reads
  priority            WorkItemPriority @default(NONE)
  assigneeMemberId    String?          @map("assignee_member_id") // XOR assigneeContactId (CHECK)
  assigneeContactId   String?          @map("assignee_contact_id") // => visibility CLIENT_VISIBLE (CHECK); written since Phase 3 slice 6c
  parentId            String?          @map("parent_id") // same project, strictly higher type (trigger)
  rootId              String           @map("root_id") // DENORMALISED — top of the tree (self at depth 0)
  depth               Int              @default(0) // 0-indexed; CHECK depth <= 2
  milestoneId         String?          @map("milestone_id")
  fixedInVersionId    String?          @map("fixed_in_version_id") // "the release that fixes it"
  rank                String // text COLLATE "C"; UNIQUE per project (migration SQL)
  estimateMinutes     Int?             @map("estimate_minutes") // hours in the UI
  remainingMinutes    Int?             @map("remaining_minutes")
  startDate           DateTime?        @map("start_date") @db.Date
  targetDate          DateTime?        @map("target_date") @db.Date
  startedAt           DateTime?        @map("started_at") @db.Timestamptz(6) // first IN_PROGRESS; cleared on regression
  completedAt         DateTime?        @map("completed_at") @db.Timestamptz(6) // DONE; cleared when leaving DONE
  visibility          Visibility       @default(INTERNAL)
  portalEnabled       Boolean          @default(false) @map("portal_enabled") // trigger-maintained
  triageStatus        TriageStatus?    @map("triage_status")
  // THE AGENCY'S WORDS TO THE CLIENT, and the only free text in this
  // model that is written by a member and read by a contact. Set by
  // Decline and Duplicate, cleared by Accept; projected by
  // `modules/work/portal.ts` beside the DECLINED category, because a
  // request that vanishes when the answer is no is the failure that
  // category exists to prevent (founder decision, 2026-09-22).
  triageReason        String?          @map("triage_reason") @db.VarChar(500)
  snoozedUntil        DateTime?        @map("snoozed_until") @db.Timestamptz(6)
  duplicateOfId       String?          @map("duplicate_of_id")
  // WHEN THE AGENCY TOOK A REQUEST ON (founder decision C31, 2026-09-25).
  // Stamped by `transitionState` on a `kind = REQUEST` row's FIRST
  // arrival in a live category from TRIAGE or CANCELLED — the lane's
  // Accept, a drag out of the lane, a reopen of a declined request — and
  // never cleared. The portal reads only WHETHER it is set: a cancelled
  // request that had been accepted is "Cancelled", one turned down in
  // triage is "Declined"; the value itself never leaves the projection.
  // Backfilled from the audit trail by 20260925120000.
  acceptedAt          DateTime?        @map("accepted_at") @db.Timestamptz(6)
  // THE CLIENT'S CLAIM THAT THEIR PART IS DONE — stamped by the contact
  // this task is assigned to, through `modules/work/portal-writes.ts`,
  // and NOTHING ELSE MOVES (founder decision, 2026-09-22). The state is
  // the agency's; `DONE` means work the agency has accepted, for
  // everyone. CHECK `work_item_contact_completed_has_assignee`: a claim
  // cannot outlive the assignment it answers, so every writer that
  // clears `assigneeContactId` clears this too. Cleared also when the
  // item reaches a DONE or CANCELLED category — the agency has answered.
  contactCompletedAt  DateTime?        @map("contact_completed_at") @db.Timestamptz(6)
  source              WorkItemSource   @default(IN_APP)
  checklistTotal      Int              @default(0) @map("checklist_total") // denormalised from description on save
  checklistDone       Int              @default(0) @map("checklist_done")
  sourceSystem        String?          @map("source_system") // "trello" | "csv" | … (Phase 6 import)
  sourceId            String?          @map("source_id") // (sourceSystem, sourceId) idempotency
  importJobId         String?          @map("import_job_id")
  createdByMemberId   String?          @map("created_by_member_id") // attribution, no FK
  reportedByContactId String?          @map("reported_by_contact_id") // attribution, no FK (PORTAL/EMAIL requests)
  archivedAt          DateTime?        @map("archived_at") @db.Timestamptz(6) // explicit archive; never silent
  deletedAt           DateTime?        @map("deleted_at") @db.Timestamptz(6) // soft delete (30 d), then hard delete
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant                 @relation(fields: [tenantId], references: [id])
  client          Client                 @relation(fields: [tenantId, clientId], references: [tenantId, id])
  project         Project                @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  state           WorkflowState          @relation(fields: [tenantId, stateId], references: [tenantId, id])
  assigneeMember  Member?                @relation("WorkItemAssigneeMember", fields: [tenantId, assigneeMemberId], references: [tenantId, id])
  assigneeContact Contact?               @relation("WorkItemAssigneeContact", fields: [tenantId, assigneeContactId], references: [tenantId, id])
  parent          WorkItem?              @relation("WorkItemParent", fields: [tenantId, parentId], references: [tenantId, id])
  children        WorkItem[]             @relation("WorkItemParent")
  milestone       Milestone?             @relation(fields: [tenantId, milestoneId], references: [tenantId, id])
  fixedInVersion  ProjectVersion?        @relation(fields: [tenantId, fixedInVersionId], references: [tenantId, id])
  duplicateOf     WorkItem?              @relation("WorkItemDuplicate", fields: [tenantId, duplicateOfId], references: [tenantId, id])
  duplicates      WorkItem[]             @relation("WorkItemDuplicate")
  activity        WorkItemActivity[]
  labels          WorkItemLabel[]
  collaborators   WorkItemCollaborator[]
  subscribers     WorkItemSubscriber[]
  timeEntries     TimeEntry[] // 2T

  @@unique([tenantId, projectId, number]) // human key ACME-12
  @@unique([tenantId, projectId, rank]) // one position per item (retry-with-jitter)
  @@unique([tenantId, id]) // composite-FK target (parent, duplicateOf, activity, labels, time entries)
  @@index([tenantId, projectId, stateId, rank]) // board column
  @@index([tenantId, projectId, stateCategory, rank]) // backlog, rollups
  @@index([tenantId, assigneeMemberId, stateCategory, targetDate]) // /home
  /// /home's "waiting on client" card (Phase 3 slice 6c) — the contact
  /// twin of the index above. PARTIAL in the migration
  /// (20260923010000): `assignee_contact_id IS NOT NULL AND deleted_at
  /// IS NULL`, which Prisma cannot express, so the schema declares the
  /// key and the migration owns the predicate.
  @@index([tenantId, assigneeContactId, stateCategory, contactCompletedAt])
  @@index([tenantId, parentId])
  @@index([tenantId, rootId]) // epic subtree rollups (flat)
  @@index([tenantId, milestoneId])
  @@index([tenantId, clientId, visibility, stateCategory]) // portal list + gate
  @@index([tenantId, projectId, archivedAt])
  @@index([tenantId, projectId, triageStatus]) // triage lane
  // The portal intake's rate budget (Phase 3 slice 6a): counts this
  // contact's own PORTAL-sourced rows inside a window, on every submit.
  @@index([tenantId, reportedByContactId, createdAt])
  @@index([tenantId, sourceSystem, sourceId]) // import idempotency
  @@map("work_item")
}

/// Field-level HISTORY (who changed what, from → to) — not AuditEvent:
/// privileged transitions are dual-written there; routine edits live
/// only here. visibility CLIENT_VISIBLE only for the portal-safe field
/// list on CLIENT_VISIBLE items (service decides, row carries it,
/// portal_gate enforces it). oldRef/newRef are ids (a member id here
/// is INTERNAL by construction).
model WorkItemActivity {
  id             String     @id @default(uuid(7))
  tenantId       String     @map("tenant_id")
  clientId       String     @map("client_id") // denormalised — RLS
  projectId      String     @map("project_id") // denormalised — portal_enabled fan-out
  workItemId     String     @map("work_item_id")
  actorMemberId  String?    @map("actor_member_id") // attribution, no FK
  actorContactId String?    @map("actor_contact_id") // attribution, no FK
  field          String // "stateCategory" | "title" | "priority" | "assignee" | …
  oldValue       String?    @map("old_value")
  newValue       String?    @map("new_value")
  oldRef         String?    @map("old_ref")
  newRef         String?    @map("new_ref")
  commentId      String?    @map("comment_id") // soft pointer when field = "comment"
  visibility     Visibility @default(INTERNAL)
  portalEnabled  Boolean    @default(false) @map("portal_enabled") // trigger-maintained
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  client   Client   @relation(fields: [tenantId, clientId], references: [tenantId, id])
  project  Project  @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  workItem WorkItem @relation(fields: [tenantId, workItemId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, workItemId, createdAt])
  // The panel's keyset page (slice 8) — 20260915120000.
  @@index([tenantId, workItemId, id])
  @@index([tenantId, clientId, visibility])
  // The portal fan-out's leg over this table, and its unindexed FK —
  // 20260920190000. Without it the only usable prefix is tenant_id.
  @@index([tenantId, projectId])
  @@map("work_item_activity")
}

/// Tenant-wide (optionally project-scoped) tags. INTERNAL-ONLY in v1 —
/// labels never reach the portal, so class A, no visibility column.
/// Tenant-wide names are unique CASE-INSENSITIVELY by the hand-written
/// partial index `label_tenant_wide_name_key` on (tenant_id, lower(name))
/// WHERE project_id IS NULL (20260915180000) — the composite unique below
/// cannot refuse them, NULLs being distinct to a unique index.
model Label {
  id        String   @id @default(uuid(7))
  tenantId  String   @map("tenant_id")
  projectId String?  @map("project_id") // NULL = tenant-wide
  name      String
  color     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  project   Project?        @relation(fields: [tenantId, projectId], references: [tenantId, id])
  workItems WorkItemLabel[]

  @@unique([tenantId, projectId, name]) // NULL projectId distinct — tenant-wide names: label_tenant_wide_name_key (above)
  @@unique([tenantId, id]) // composite-FK target
  @@map("label")
}

/// Join. Class A like Label.
model WorkItemLabel {
  tenantId   String   @map("tenant_id")
  workItemId String   @map("work_item_id")
  labelId    String   @map("label_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  workItem WorkItem @relation(fields: [tenantId, workItemId], references: [tenantId, id], onDelete: Cascade)
  label    Label    @relation(fields: [tenantId, labelId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, workItemId, labelId])
  @@index([tenantId, labelId])
  @@map("work_item_label")
}

/// Extra members on an item (not the assignee). Drives notifications
/// (participating) and "my work" collaborating. Members only.
model WorkItemCollaborator {
  tenantId   String   @map("tenant_id")
  workItemId String   @map("work_item_id")
  memberId   String   @map("member_id")
  addedById  String?  @map("added_by_id") // attribution, no FK
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  workItem WorkItem @relation(fields: [tenantId, workItemId], references: [tenantId, id], onDelete: Cascade)
  member   Member   @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, workItemId, memberId])
  @@index([tenantId, memberId])
  @@map("work_item_collaborator")
}

/// Explicit watch/mute per member per item — the hottest fan-out
/// lookup, so its own narrow table (generic Subscription covers other
/// entity types).
model WorkItemSubscriber {
  tenantId   String            @map("tenant_id")
  workItemId String            @map("work_item_id")
  memberId   String            @map("member_id")
  level      SubscriptionLevel @default(WATCH)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  workItem WorkItem @relation(fields: [tenantId, workItemId], references: [tenantId, id], onDelete: Cascade)
  member   Member   @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, workItemId, memberId])
  @@index([tenantId, memberId])
  @@map("work_item_subscriber")
}

/// What a Comment hangs on. PROJECT_VERSION covers release-note threads.
enum CommentSubjectType {
  WORK_ITEM
  PROJECT_UPDATE
  DOCUMENT
  FILE_VERSION
  PROJECT_VERSION

  @@map("comment_subject_type")
}

/// ONE polymorphic thread table. Staff write INTERNAL comments on
/// CLIENT_VISIBLE items (DB default INTERNAL); contact-authored
/// comments are FORCED CLIENT_VISIBLE — the one table a contact
/// principal INSERTs directly (WITH CHECK in the migration; the
/// contact-writable census). subjectId is a soft pointer validated by
/// trigger — never used for authorization (§10); clientId/projectId
/// are denormalised from the subject by the same trigger.
model Comment {
  id              String             @id @default(uuid(7))
  tenantId        String             @map("tenant_id")
  clientId        String?            @map("client_id") // NULL only for tenant-internal documents
  projectId       String?            @map("project_id")
  subjectType     CommentSubjectType @map("subject_type")
  subjectId       String             @map("subject_id") // soft pointer (trigger-validated)
  parentId        String?            @map("parent_id") // threaded reply, same subject (trigger)
  authorMemberId  String?            @map("author_member_id") // XOR authorContactId (CHECK); attribution, no FK
  authorContactId String?            @map("author_contact_id") // attribution, no FK
  body            Json // Tiptap JSON
  bodyText        String             @map("body_text") // extracted text (search feed, email, previews)
  visibility      Visibility         @default(INTERNAL) // contact-authored forced CLIENT_VISIBLE
  portalEnabled   Boolean            @default(false) @map("portal_enabled") // trigger-maintained (TRUE when projectId NULL)
  editedAt        DateTime?          @map("edited_at") @db.Timestamptz(6)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(6) // soft delete keeps the thread shape
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  client   Client?   @relation(fields: [tenantId, clientId], references: [tenantId, id])
  project  Project?  @relation(fields: [tenantId, projectId], references: [tenantId, id])
  parent   Comment?  @relation("CommentThread", fields: [tenantId, parentId], references: [tenantId, id])
  replies  Comment[] @relation("CommentThread")
  mentions Mention[]

  @@unique([tenantId, id])
  @@index([tenantId, subjectType, subjectId, createdAt])
  @@index([tenantId, clientId, visibility])
  @@index([tenantId, projectId, createdAt])
  @@map("comment")
}

/// Extracted @-mentions (ids only) for notification fan-out and the
/// "mentioned a Contact on an INTERNAL item" warning. Never rendered
/// from here.
model Mention {
  id                 String   @id @default(uuid(7))
  tenantId           String   @map("tenant_id")
  commentId          String   @map("comment_id")
  mentionedMemberId  String?  @map("mentioned_member_id") // XOR mentionedContactId; id only, no FK
  mentionedContactId String?  @map("mentioned_contact_id")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  comment Comment @relation(fields: [tenantId, commentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, commentId, mentionedMemberId, mentionedContactId])
  @@index([tenantId, mentionedMemberId])
  @@map("mention")
}

/// "Pick a template" is the ONLY process picker (UI.md rule 13).
/// Tenant-owned rows only — platform templates are COPIED in at
/// provisioning (no nullable tenantId; keeps RLS and the census clean).
model ProjectTemplate {
  id                String   @id @default(uuid(7))
  tenantId          String   @map("tenant_id")
  name              String
  description       String?
  locale            String? // language of the seeded titles (informational)
  definition        Json // { states, epics: [{title, items}], milestones, settings }
  createdByMemberId String?  @map("created_by_member_id") // attribution, no FK
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("project_template")
}

// ───────────────────────────────────────────────────────────────────
// NOTIFICATIONS & EMAIL (core, never entitlement-gated) — §6.18
// One seam: notify.emit(tx, …) inside the same withTenant transaction
// as the write. Static kind catalog (TS module) fixes audience/class/
// template per kind; every CONTACT-audience kind is clientVisibleOnly
// (CI-tested). Worker drains EmailOutbox under the platform system
// principal with FOR UPDATE SKIP LOCKED. PushSubscription is Phase 5
// slice 106 (src/jobs/push.ts drains by `notification.pushed_at`);
// InboundEmail is later, if ever.
// ───────────────────────────────────────────────────────────────────

enum ReceiverType {
  MEMBER
  CONTACT

  @@map("receiver_type")
}

enum NotificationClass {
  INSTANT // in-app + email now (assignment, mention)
  COALESCED // in-app now, email folded into digest / per-item coalesce
  DIGEST_ONLY // in-app only, digest mention

  @@map("notification_class")
}

/// One row per receiver per event. params carries IDS ONLY — the
/// UI/email renders from live rows under the RECEIVER's principal, so
/// a notification can never leak a fact the receiver cannot read now.
/// CONTACT rows: clientId REQUIRED (CHECK); readable + updatable
/// (readAt/archivedAt ONLY — column-level GRANT + policy WITH CHECK)
/// by the contact — the Notification entry in the contact-writable
/// census. Member rows: contact principals never see them (policy).
model Notification {
  id           String            @id @default(uuid(7))
  tenantId     String            @map("tenant_id")
  receiverType ReceiverType      @map("receiver_type")
  receiverId   String            @map("receiver_id") // Member.id | Contact.id (bound to app.principal_id for contacts)
  clientId     String?           @map("client_id") // REQUIRED for CONTACT receivers (CHECK)
  projectId    String?           @map("project_id") // grouping hint, no FK
  kind         String // catalog code, e.g. "work_item.assigned"
  class        NotificationClass @default(COALESCED)
  entityType   String            @map("entity_type")
  entityId     String            @map("entity_id")
  actorType    ActorType?        @map("actor_type")
  actorId      String?           @map("actor_id")
  params       Json? // ids only, zod-validated per kind
  dedupeKey    String?           @map("dedupe_key")
  /// Why it reached the receiver (slice 104, C72 (d); src/notify/reasons.ts): a closed set held by a CHECK; NULL before this column existed and for contacts. Written once by `emit` — the runtime role cannot UPDATE it.
  reason       String?
  readAt       DateTime?         @map("read_at") @db.Timestamptz(6)
  archivedAt   DateTime?         @map("archived_at") @db.Timestamptz(6)
  snoozedTill  DateTime?         @map("snoozed_till") @db.Timestamptz(6)
  emailedAt    DateTime?         @map("emailed_at") @db.Timestamptz(6) // set by the outbox worker
  // Phase 5 slice 106 (C74): the push drain has DEALT with this notification —
  // sent, or decided not to — and never reconsiders it (at most once). Only the
  // SYSTEM principal may change it (trigger `notification_pushed_at_guard`).
  pushedAt     DateTime?         @map("pushed_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  client Client? @relation(fields: [tenantId, clientId], references: [tenantId, id])

  @@index([tenantId, receiverType, receiverId, createdAt(sort: Desc)])
  @@index([tenantId, receiverType, receiverId, dedupeKey])
  @@index([tenantId, entityType, entityId])
  @@map("notification")
}

/// Shared with WorkItemSubscriber.
enum SubscriptionLevel {
  WATCH // everything on the entity
  PARTICIPATE // default when you touch it
  MUTED

  @@map("subscription_level")
}

/// Explicit per-entity subscription for entities other than WorkItem.
/// Members only in v1.
model Subscription {
  tenantId   String            @map("tenant_id")
  memberId   String            @map("member_id")
  entityType String            @map("entity_type")
  entityId   String            @map("entity_id")
  level      SubscriptionLevel @default(PARTICIPATE)
  reason     String? // "assigned" | "commented" | "manual"
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  member Member @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, memberId, entityType, entityId])
  @@index([tenantId, entityType, entityId])
  @@map("subscription")
}

enum EmailLevel {
  ALL
  PARTICIPATING
  MENTIONS
  NONE

  @@map("email_level")
}

enum DigestCadence {
  NONE
  DAILY
  WEEKLY

  @@map("digest_cadence")
}

/// Per member (Phase 5: per contact, written by the system principal —
/// contacts do not edit it in v1). receiverId is polymorphic — no FK.
model NotificationPreference {
  id                   String        @id @default(uuid(7))
  tenantId             String        @map("tenant_id")
  receiverType         ReceiverType  @default(MEMBER) @map("receiver_type")
  receiverId           String        @map("receiver_id")
  emailLevel           EmailLevel    @default(PARTICIPATING) @map("email_level")
  inAppLevel           EmailLevel    @default(ALL) @map("in_app_level")
  digestCadence        DigestCadence @default(DAILY) @map("digest_cadence")
  digestHour           Int           @default(8) @map("digest_hour")
  digestWeekday        Int?          @map("digest_weekday") // 1 = Monday (WEEKLY)
  // Phase 5 slice 105 (founder decision C73 (e), (f)): QUIET HOURS — whole
  // local hours, `from` inclusive, `to` exclusive (19 → 7 spans midnight);
  // both set and different, or neither (CHECK); `quietWeekends` adds all of
  // Saturday and Sunday. Work emails wait until they end
  // (src/notify/quiet-hours.ts); nothing else does.
  quietHoursFrom       Int?          @map("quiet_hours_from") // 0-23 local
  quietHoursTo         Int?          @map("quiet_hours_to")
  quietWeekends        Boolean       @default(false) @map("quiet_weekends")
  // Phase 5 slice 106 (founder decision C74 (b)): the PHONE's own level — the
  // email ladder's four steps, set separately (src/push/verdict.ts).
  pushLevel            EmailLevel    @default(PARTICIPATING) @map("push_level")
  timezone             String?
  perKind              Json?         @map("per_kind") // { "<kind>": {email, inApp} }
  unsubscribeTokenHash String?       @map("unsubscribe_token_hash") // RFC 8058 (digests, Phase 5)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, receiverType, receiverId])
  @@map("notification_preference")
}

/// PushSubscription [Phase 5 slice 106; founder decision C74] — one browser
/// (or installed app) that gets ONE member's phone and browser notifications
/// (Web Push, RFC 8030/8291/8292; ARC-25 Stage B). Content-free on the lock
/// screen: what happened, never a name (src/push/payload.ts).
///
/// LIVE ONLY WHILE ITS SIGN-IN IS (C74 (d)): `sessionId` is the member-plane
/// session it was turned on or last resumed under — no FK, Better Auth deletes
/// sessions on sign-out, "Your devices" and an owner's reset, and lets them
/// expire after a week unused; the drain sends only to a row whose session is
/// still alive, is the member's own user's, and is not impersonated. The same
/// person signing in there again re-links it (`resumePushDevices`). Dormant
/// for 90 days, or its member no longer ACTIVE: deleted (src/jobs/push.ts).
///
/// `vapidKey` is the fingerprint of OUR public key the browser subscribed with:
/// a server sends only to rows made with its own key (another environment's
/// rows on a shared or copied database are invisible to its sends — never
/// counted against; only the housekeeping's member/session rules reach them). `keysCiphertext` = v2 {p256dh, auth}, AAD
/// `tenantId:push_subscription:<id>:keys`. One browser may hold rows for two
/// members (a shared computer) — `(tenant, member, endpoint)` is the key.
/// scope=tenant  rls=A (+ RESTRICTIVE own_device)  ret=§10  enc=keysCiphertext
model PushSubscription {
  id             String    @id @default(uuid(7))
  tenantId       String    @map("tenant_id")
  memberId       String    @map("member_id")
  endpoint       String
  keysCiphertext String    @map("keys_ciphertext")
  vapidKey       String    @map("vapid_key")
  label          String
  sessionId      String    @map("session_id")
  boundAt        DateTime  @map("bound_at") @db.Timestamptz(6)
  failCount      Int       @default(0) @map("fail_count")
  lastSentAt     DateTime? @map("last_sent_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  member Member @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, memberId, endpoint])
  @@map("push_subscription")
}

enum EmailOutboxStatus {
  QUEUED
  SENDING // lockedAt set; SKIP LOCKED worker owns it
  SENT
  FAILED // retry with backoff (attempts < max)
  DEAD // gave up; platform console
  SUPPRESSED // recipient on EmailSuppression
  SKIPPED // debounce cancelled (e.g. assignment read within 2 min)

  @@map("email_outbox_status")
}

/// The Postgres outbox (ARC-21). idempotencyKey unique = the whole
/// exactly-once story. params (template inputs) nulled at 90 d;
/// delivery metadata kept 12 mo. Worker runs under withPlatform
/// system, cross-tenant.
model EmailOutbox {
  id              String            @id @default(uuid(7))
  tenantId        String            @map("tenant_id")
  idempotencyKey  String            @unique @map("idempotency_key")
  receiverType    ReceiverType      @map("receiver_type")
  receiverId      String            @map("receiver_id")
  toEmail         String            @map("to_email") // lowercase snapshot at enqueue
  kind            String // template key
  locale          String
  params          Json? // nulled at 90 d
  notificationIds String[]          @default([]) @map("notification_ids")
  configSet       String?           @map("config_set") // SES configuration set
  sendAfter       DateTime          @default(now()) @map("send_after") @db.Timestamptz(6) // debounce / digest scheduling / quiet hours
  // Phase 5 slice 105 (C73 (e), (h)): this work email was held by its
  // receiver's quiet hours — at its release it is SKIPPED when every
  // notification behind it was read (or is snoozed) in the inbox meanwhile.
  quietHeld       Boolean           @default(false) @map("quiet_held")
  status          EmailOutboxStatus @default(QUEUED)
  attempts        Int               @default(0)
  lastError       String?           @map("last_error")
  lockedAt        DateTime?         @map("locked_at") @db.Timestamptz(6)
  sentAt          DateTime?         @map("sent_at") @db.Timestamptz(6)
  sesMessageId    String?           @map("ses_message_id")
  messageIdHeader String?           @map("message_id_header") // threading / reply-by-email (Phase 5)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([status, sendAfter]) // worker pick (cross-tenant, SYSTEM)
  @@index([tenantId, receiverType, receiverId, createdAt(sort: Desc)])
  @@map("email_outbox")
}

enum SuppressionReason {
  HARD_BOUNCE
  COMPLAINT
  UNSUBSCRIBED // RFC 8058 / preference NONE
  MANUAL

  @@map("suppression_reason")
}

/// GLOBAL (platform-owned): an address that bounced or complained is
/// never mailed again from any tenant (SES reputation is shared).
/// Checked at enqueue and at send. No tenant column by design.
model EmailSuppression {
  email     String            @id // lowercase
  reason    SuppressionReason
  source    String? // "ses-sns" | "manual" | "unsubscribe"
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("email_suppression")
}

// ───────────────────────────────────────────────────────────────────
// TIME (Phase 2T) — DATA_MODEL.md §6.15 as amended 2026-08-20 (D1–D6);
// module `time` (src/modules/time). Posture (SECURITY.md §9.7): self-
// reported tidsredovisning only — no IP, device, location or activity
// column exists on any table here, by rule. TimeEntry/Shift/RateCard/
// budgets/notice/work types are class A (the portal never reads them);
// ProjectTimeSummary and TimeReport are the ONLY portal time surfaces
// (class B projectScoped; member-free by construction). Every CHECK,
// partial unique and trigger named in §6.15 lives in the hand-written
// migration; comments here state only what the service relies on.
// ───────────────────────────────────────────────────────────────────

enum TimeEntryMode {
  TIMER
  MANUAL
  DURATION

  @@map("time_entry_mode")
}

enum TimeEntrySource {
  TIMER
  MANUAL
  IMPORT

  @@map("time_entry_source")
}

/// Which tier resolved the bill rate at WRITE time (never at read).
enum RateSource {
  SERVICE // the explicitly picked agreement's card (D4) — outranks ambient tiers
  PROJECT_MEMBER
  PROJECT
  MEMBER
  TENANT
  MANUAL
  NONE

  @@map("rate_source")
}

/// Why an entry is frozen. Invoicing sets INVOICED / INVOICE_DRAFT in
/// Phase 4; LOCK_DATE and APPROVED are reserved values.
enum TimeLockReason {
  INVOICED
  INVOICE_DRAFT
  LOCK_DATE
  APPROVED
  BILLED_EXTERNAL
  WRITTEN_OFF

  @@map("time_lock_reason")
}

enum TimeReviewReason {
  AUTO_STOPPED
  OVERLAP_TRUNCATED
  STOP_BEFORE_START
  SKEW_CLAMPED

  @@map("time_review_reason")
}

enum RateKind {
  BILL // what the client pays — the founder's "cost per hour for the project"
  COST // internal cost (salary-derived) — encrypted, finance-only

  @@map("rate_kind")
}

enum RateScope {
  TENANT
  MEMBER
  PROJECT
  PROJECT_MEMBER
  SERVICE // the agreement's own BILL rate (D4); COST never uses it (CHECK)

  @@map("rate_scope")
}

enum BudgetKind {
  HOURS
  MONEY

  @@map("budget_kind")
}

enum BillingModel {
  T_AND_M
  FIXED_FEE
  RETAINER
  NON_BILLABLE

  @@map("billing_model")
}

enum BudgetPeriod {
  NONE
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY

  @@map("budget_period")
}

enum BudgetStatus {
  ACTIVE
  ARCHIVED

  @@map("budget_status")
}

enum TimeReportStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("time_report_status")
}

enum TimeReportGroupBy {
  DAY
  WORK_ITEM
  EPIC
  SERVICE

  @@map("time_report_group_by")
}

/// One row per (member, interval); NULL stoppedAt = RUNNING (partial
/// unique `time_entry_one_running` = one running timer per member, DB-
/// enforced). clientId/projectId are nullable AS A PAIR (D2 ad-hoc
/// "instant task": description-only, forced non-billable by CHECK).
/// billRate is a plaintext SNAPSHOT resolved at write; cost is
/// costRateCardId ONLY (never the amount). lockedReason ⇒ the lock
/// trigger refuses UPDATE/DELETE unless app.time_lock_bypass = 'on'
/// (transaction-local, invoicing only, always audited). Class A — no
/// visibility column, never portal-reachable. The service writes
/// whole-second timestamps; durationSeconds = floor(epoch diff) (CHECK).
model TimeEntry {
  id                 String            @id @default(uuid(7))
  tenantId           String            @map("tenant_id")
  clientId           String?           @map("client_id") // denormalised from project; NULL = ad-hoc (pair-null with projectId)
  projectId          String?           @map("project_id")
  serviceId          String?           @map("service_id") // the chosen agreement (D4)
  workTypeId         String?           @map("work_type_id") // analytics dimension (D5), never rate-bearing
  workItemId         String?           @map("work_item_id") // NULL = project-level (description required)
  memberId           String            @map("member_id")
  description        String?
  startedAt          DateTime          @map("started_at") @db.Timestamptz(6)
  stoppedAt          DateTime?         @map("stopped_at") @db.Timestamptz(6) // NULL = running
  durationSeconds    Int?              @map("duration_seconds") // CHECK-tied to stoppedAt; raw, never rounded
  timezone           String            @db.VarChar(64) // IANA at write (Member.timezone → tenant)
  localDate          DateTime          @map("local_date") @db.Date // start date in `timezone`
  entryMode          TimeEntryMode     @map("entry_mode")
  source             TimeEntrySource   @default(TIMER)
  billable           Boolean
  billRate           Decimal?          @map("bill_rate") @db.Decimal(12, 2) // plaintext snapshot; NULL when non-billable
  currency           String?           @db.Char(3)
  rateSource         RateSource        @default(NONE) @map("rate_source")
  billRateCardId     String?           @map("bill_rate_card_id")
  costRateCardId     String?           @map("cost_rate_card_id") // id ONLY — never the amount
  lockedReason       TimeLockReason?   @map("locked_reason")
  lockedAt           DateTime?         @map("locked_at") @db.Timestamptz(6)
  invoiceLineId      String?           @map("invoice_line_id") // Phase 4
  retainerPeriodId   String?           @map("retainer_period_id") // Phase 4
  billedExternallyAt DateTime?         @map("billed_externally_at") @db.Timestamptz(6)
  writtenOffAt       DateTime?         @map("written_off_at") @db.Timestamptz(6)
  needsReview        Boolean           @default(false) @map("needs_review")
  reviewReason       TimeReviewReason? @map("review_reason")
  clientEventId      String?           @map("client_event_id") // offline queue (v1.5; reserved)
  clientStartedAt    DateTime?         @map("client_started_at") @db.Timestamptz(6)
  skewMs             Int?              @map("skew_ms")
  createdByMemberId  String?           @map("created_by_member_id") // ≠ memberId ⇒ time_entry.edited_by_other
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamptz(6) // soft delete; excluded from the running index
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  client       Client?   @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  project      Project?  @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  service      Service?  @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  workType     WorkType? @relation(fields: [tenantId, workTypeId], references: [tenantId, id], onDelete: Restrict)
  workItem     WorkItem? @relation(fields: [tenantId, workItemId], references: [tenantId, id], onDelete: Restrict)
  member       Member    @relation(fields: [tenantId, memberId], references: [tenantId, id])
  billRateCard RateCard? @relation("TimeEntryBillRateCard", fields: [tenantId, billRateCardId], references: [tenantId, id], onDelete: Restrict)
  costRateCard RateCard? @relation("TimeEntryCostRateCard", fields: [tenantId, costRateCardId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, memberId, clientEventId]) // offline idempotency (NULLs distinct)
  @@index([tenantId, memberId, startedAt(sort: Desc)]) // My Time
  @@index([tenantId, projectId, startedAt]) // project time tab, summary recompute
  @@index([tenantId, workItemId]) // Σ spent on a card
  @@index([tenantId, serviceId]) // per-agreement rollups + consumption strip
  @@index([tenantId, workTypeId]) // per-type rollups
  @@index([tenantId, localDate, memberId]) // week grid, team view
  @@index([tenantId, costRateCardId]) // cost aggregation GROUP BY
  @@index([tenantId, billRateCardId]) // reprice scope
  @@index([tenantId, invoiceLineId]) // Phase 4
  @@map("time_entry")
}

/// IMMUTABLE ROWS (trigger: only effectiveTo may change, NULL → date):
/// a change = close the old row + insert a new one, so a card id is a
/// stable snapshot TimeEntry rows point at forever. amount (BILL) is
/// plaintext; amountCiphertext (COST) is v2-encrypted with AAD
/// `tenantId:rate_card:<id>:amount` and omitted from every client read
/// (src/db/client.ts) — rates.ts opts back in behind rate:view_cost ✦ +
/// recent MFA. No-overlap per (tenant, kind, scope, member, project,
/// service) is an EXCLUDE constraint (btree_gist, verified on Neon).
model RateCard {
  id                String    @id @default(uuid(7))
  tenantId          String    @map("tenant_id")
  kind              RateKind
  scope             RateScope
  memberId          String?   @map("member_id") // MEMBER / PROJECT_MEMBER
  projectId         String?   @map("project_id") // PROJECT / PROJECT_MEMBER
  serviceId         String?   @map("service_id") // SERVICE (D4)
  amount            Decimal?  @db.Decimal(12, 2) // BILL only, plaintext
  amountCiphertext  String?   @map("amount_ciphertext") // COST only — v2 ENCRYPTED, AAD-bound, omitted
  currency          String    @db.Char(3)
  effectiveFrom     DateTime  @map("effective_from") @db.Date
  effectiveTo       DateTime? @map("effective_to") @db.Date // NULL = open; the ONLY mutable column
  createdByMemberId String?   @map("created_by_member_id")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  member      Member?     @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Restrict)
  project     Project?    @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  service     Service?    @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  billEntries TimeEntry[] @relation("TimeEntryBillRateCard")
  costEntries TimeEntry[] @relation("TimeEntryCostRateCard")

  @@unique([tenantId, id])
  @@index([tenantId, kind, scope, projectId, memberId, effectiveFrom]) // resolution lookup
  @@index([tenantId, serviceId, kind]) // agreement-rate lookup
  @@index([tenantId, memberId, kind])
  @@map("rate_card")
}

/// Hours-or-money budget with once-per-threshold alerts; one ACTIVE per
/// project (partial unique). RETAINER here is intent + a cap — the
/// hour-bank ledger is Phase 4. Class A: budget figures reach the
/// portal only through ProjectTimeSummary when the mode allows.
model ProjectBudget {
  id                 String       @id @default(uuid(7))
  tenantId           String       @map("tenant_id")
  clientId           String       @map("client_id")
  projectId          String       @map("project_id")
  kind               BudgetKind
  billingModel       BillingModel @default(T_AND_M) @map("billing_model")
  amount             Decimal      @db.Decimal(12, 2) // decimal hours or money
  currency           String?      @db.Char(3) // MONEY: = Project.billingCurrency
  period             BudgetPeriod @default(NONE)
  periodAnchor       DateTime?    @map("period_anchor") @db.Date
  includeNonBillable Boolean      @default(false) @map("include_non_billable")
  thresholds         Int[]        @default([80, 100]) // percentages, sorted by the app
  notifyMemberIds    String[]     @default([]) @map("notify_member_ids")
  status             BudgetStatus @default(ACTIVE)
  createdByMemberId  String?      @map("created_by_member_id")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  client  Client        @relation(fields: [tenantId, clientId], references: [tenantId, id])
  project Project       @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  alerts  BudgetAlert[]

  @@unique([tenantId, id])
  @@index([tenantId, projectId, status])
  @@map("project_budget")
}

/// Once per (budget, period, threshold): the unique IS the dedupe — the
/// hourly budget job INSERTs and a conflict means "already sent".
model BudgetAlert {
  id        String   @id @default(uuid(7))
  tenantId  String   @map("tenant_id")
  budgetId  String   @map("budget_id")
  periodKey String   @map("period_key") // "ALL" | "2026-W34" | "2026-08" | …
  threshold Int
  sentAt    DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  budget ProjectBudget @relation(fields: [tenantId, budgetId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, budgetId, periodKey, threshold])
  @@map("budget_alert")
}

/// THE ONLY LIVE PORTAL TIME SURFACE — a physical class-B table (a view
/// under FORCE RLS returns 0 rows to a contact), one row per (project,
/// month), NO MEMBER ID COLUMN BY CONSTRUCTION. RECOMPUTED (never delta-
/// upserted) for the touched (project, month) in the same transaction
/// as every time_entry write (`INSERT … ON CONFLICT DO UPDATE`).
/// visibility is trigger-DERIVED from Project.hoursSharingMode
/// (CLIENT_VISIBLE iff ≠ NONE); billableAmount is nulled by the same
/// trigger unless the mode is BILLABLE_AMOUNT; portalEnabled is the
/// usual projectScoped stamp. The portal reads it under the contact
/// principal via RLS — never through a system bypass.
model ProjectTimeSummary {
  id                 String     @id @default(uuid(7))
  tenantId           String     @map("tenant_id")
  clientId           String     @map("client_id")
  projectId          String     @map("project_id")
  periodMonth        DateTime   @map("period_month") @db.Date // first day of month
  billableSeconds    Int        @default(0) @map("billable_seconds")
  nonBillableSeconds Int        @default(0) @map("non_billable_seconds")
  billableAmount     Decimal?   @map("billable_amount") @db.Decimal(12, 2) // only when hoursSharingMode = BILLABLE_AMOUNT
  budgetSeconds      Int?       @map("budget_seconds") // from the ACTIVE HOURS budget, when shared
  budgetAmount       Decimal?   @map("budget_amount") @db.Decimal(12, 2) // from the ACTIVE MONEY budget, when shared
  currency           String?    @db.Char(3)
  visibility         Visibility @default(INTERNAL) // trigger-derived from Project.hoursSharingMode
  portalEnabled      Boolean    @default(false) @map("portal_enabled") // trigger-maintained
  computedAt         DateTime   @default(now()) @map("computed_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  client  Client  @relation(fields: [tenantId, clientId], references: [tenantId, id])
  project Project @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, projectId, periodMonth])
  @@index([tenantId, clientId, visibility])
  @@map("project_time_summary")
}

/// What the tenant tells its staff before time tracking starts (Art. 13
/// GDPR; MBL 19 §; NY/CT/DE by jurisdictionTags). Versioned & immutable
/// in effect (a republish = new version); one row per locale per
/// version. Timers AND clock-in refuse to start until the member has
/// acknowledged the current version. sv/en text is seeded per tenant.
model StaffNotice {
  id                  String    @id @default(uuid(7))
  tenantId            String    @map("tenant_id")
  version             Int
  locale              String // "sv" | "en"
  title               String
  body                String // markdown
  purposes            String[] // ["billing","planning","profitability","working_time"]
  jurisdictionTags    String[]  @map("jurisdiction_tags") // ["SE","US-NY",…]
  publishedAt         DateTime? @map("published_at") @db.Timestamptz(6)
  publishedByMemberId String?   @map("published_by_member_id") // NULL = seeded
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant                      @relation(fields: [tenantId], references: [id])
  acknowledgments StaffNoticeAcknowledgment[]

  @@unique([tenantId, version, locale])
  @@unique([tenantId, id])
  @@map("staff_notice")
}

/// One per (member, notice version): evidence of the information duty
/// (notice, NOT consent — SECURITY.md §9.7.1). Pseudonymised, not
/// deleted, on erasure.
model StaffNoticeAcknowledgment {
  id             String   @id @default(uuid(7))
  tenantId       String   @map("tenant_id")
  memberId       String   @map("member_id")
  noticeId       String   @map("notice_id")
  noticeVersion  Int      @map("notice_version")
  locale         String // which rendering was shown
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at") @db.Timestamptz(6)

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  member Member      @relation(fields: [tenantId, memberId], references: [tenantId, id])
  notice StaffNotice @relation(fields: [tenantId, noticeId], references: [tenantId, id])

  @@unique([tenantId, memberId, noticeId, noticeVersion])
  @@index([tenantId, memberId])
  @@map("staff_notice_acknowledgment")
}

/// Self-reported attendance (D1): clock-in/out with breaks as rows. One
/// open shift per member (partial unique `shift_one_open`); workedSeconds
/// = span − Σ breaks, service-maintained and property-tested; the
/// shrink guard refuses an edit that would orphan a break. NO live
/// presence: team surfaces aggregate CLOSED rows only for other
/// members, and no helper selects an open flag for another member
/// (SECURITY.md §9.7 never-list). Reuses the time:* codes.
model Shift {
  id                String            @id @default(uuid(7))
  tenantId          String            @map("tenant_id")
  memberId          String            @map("member_id")
  startedAt         DateTime          @map("started_at") @db.Timestamptz(6)
  stoppedAt         DateTime?         @map("stopped_at") @db.Timestamptz(6) // NULL = open
  workedSeconds     Int?              @map("worked_seconds") // service-maintained = span − Σ breaks
  timezone          String            @db.VarChar(64)
  localDate         DateTime          @map("local_date") @db.Date // start date in `timezone`
  note              String?
  needsReview       Boolean           @default(false) @map("needs_review")
  reviewReason      TimeReviewReason? @map("review_reason") // AUTO_STOPPED — visibly provisional until confirmed
  createdByMemberId String?           @map("created_by_member_id") // ≠ memberId ⇒ shift.edited_by_other
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz(6) // soft delete; excluded from the open index
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  member Member       @relation(fields: [tenantId, memberId], references: [tenantId, id])
  breaks ShiftBreak[]

  @@unique([tenantId, id]) // composite-FK target (ShiftBreak)
  @@index([tenantId, memberId, startedAt(sort: Desc)])
  @@index([tenantId, localDate, memberId]) // day grids, team totals, statement export
  @@map("shift")
}

/// A break ROW inside a shift (rows, not pause events). Hard delete. One
/// open break per shift (partial unique); bounds enforced by trigger
/// (inside the parent shift; memberId stamped from the shift). A
/// recorded break = rast (unpaid) in v1 — stated in the staff notice.
model ShiftBreak {
  id                String    @id @default(uuid(7))
  tenantId          String    @map("tenant_id")
  shiftId           String    @map("shift_id")
  memberId          String    @map("member_id") // denormalised (stamped by trigger) — break totals per member/day without a join
  startedAt         DateTime  @map("started_at") @db.Timestamptz(6)
  stoppedAt         DateTime? @map("stopped_at") @db.Timestamptz(6) // NULL = open
  durationSeconds   Int?      @map("duration_seconds") // CHECK-tied, as on TimeEntry
  note              String?
  createdByMemberId String?   @map("created_by_member_id")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  shift  Shift  @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Cascade)
  member Member @relation(fields: [tenantId, memberId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, shiftId])
  @@index([tenantId, memberId, startedAt])
  @@map("shift_break")
}

/// An EXPLICITLY published, IMMUTABLE client time report (D3). The
/// snapshot is client-safe by construction: the generator never selects
/// member_id, and lines carry an entity's name only when that entity is
/// CLIENT_VISIBLE — INTERNAL ones fold into "Other work" at generation.
/// portal_gate is FOUR-term (client AND CLIENT_VISIBLE AND portal_enabled
/// AND status = 'PUBLISHED'); once publishedAt is set only status
/// (PUBLISHED → ARCHIVED), visibility and the stamped/updated columns may
/// change (trigger), and the row can no longer be deleted. Publish =
/// status + visibility + publishedAt in ONE audited tx; unpublish =
/// visibility → INTERNAL.
model TimeReport {
  id                  String            @id @default(uuid(7))
  tenantId            String            @map("tenant_id")
  clientId            String            @map("client_id")
  projectId           String            @map("project_id")
  title               String
  periodStart         DateTime          @map("period_start") @db.Date
  periodEnd           DateTime          @map("period_end") @db.Date
  groupBy             TimeReportGroupBy @default(DAY) @map("group_by")
  includeAmounts      Boolean           @default(false) @map("include_amounts")
  includeNonBillable  Boolean           @default(false) @map("include_non_billable")
  snapshot            Json // lines + totals; NEVER a member key; INTERNAL names folded
  totalSeconds        Int               @default(0) @map("total_seconds")
  billableSeconds     Int               @default(0) @map("billable_seconds")
  billableAmount      Decimal?          @map("billable_amount") @db.Decimal(12, 2) // only when includeAmounts
  currency            String?           @db.Char(3) // = Project.billingCurrency at generation
  status              TimeReportStatus  @default(DRAFT)
  visibility          Visibility        @default(INTERNAL) // publish flips to CLIENT_VISIBLE; app-written
  portalEnabled       Boolean           @default(false) @map("portal_enabled") // trigger-maintained
  generatedAt         DateTime          @default(now()) @map("generated_at") @db.Timestamptz(6)
  publishedAt         DateTime?         @map("published_at") @db.Timestamptz(6)
  publishedByMemberId String?           @map("published_by_member_id")
  createdByMemberId   String?           @map("created_by_member_id")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  client  Client  @relation(fields: [tenantId, clientId], references: [tenantId, id])
  project Project @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, projectId, periodStart])
  @@index([tenantId, clientId, visibility])
  @@map("time_report")
}

/// Tenant-editable time category (D5) — a LOOKUP TABLE, not an enum, and
/// NOT rate-bearing (differentiated pricing = a second agreement).
/// defaultBillable (nullable) seeds TimeEntry.billable: explicit choice →
/// workType.defaultBillable → project.defaultBillable. Seeded per tenant
/// in the tenant's default locale; names unique among LIVE rows
/// (partial unique); archived types stay on history, leave pickers.
model WorkType {
  id                String    @id @default(uuid(7))
  tenantId          String    @map("tenant_id")
  name              String
  sortOrder         Int       @default(0) @map("sort_order")
  defaultBillable   Boolean?  @map("default_billable") // NULL = inherit project.defaultBillable
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(6)
  createdByMemberId String?   @map("created_by_member_id")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant      @relation(fields: [tenantId], references: [id])
  entries TimeEntry[]

  @@unique([tenantId, id])
  @@index([tenantId, archivedAt, sortOrder]) // picker: live rows in order
  @@map("work_type")
}

// ───────────────────────────────────────────────────────────────────
// 6.17 VAULT (Phase 3V) — module `vault`. Credentials live NEXT TO the
// client/project, masked by default; reveal is an explicit, audited,
// step-up act (src/modules/vault/reveal.ts). The split IS the design:
// metadata on a class-B row, ciphertext on a class-A twin that a
// contact principal can never SELECT (portal_deny), and the client's
// global `omit` keeps the ciphertext out of every read but the two that
// opt back in (src/db/client.ts). Asset links (`assetId`) land with the
// slice that builds their surface; portal submission attribution
// (`submittedByContactId`) landed with slice 96 (migration
// 20261006180000). Migration 20261001120000_vault_core.
// ───────────────────────────────────────────────────────────────────

enum CredentialType {
  LOGIN
  SECURE_NOTE
  API_KEY
  SSH_KEY
  DATABASE
  SERVER
  WIFI
  SOFTWARE_LICENSE
  OTHER

  @@map("credential_type")
}

/// CredentialItem — METADATA ONLY (class B, clientScoped; `projectId` is
/// a filter, never a portal gate, so no `portal_enabled`). The secret is
/// on CredentialSecret. `clientId` NULL = the agency's own login, in
/// scope only for a member who sees every client (C49). CLIENT_VISIBLE
/// since slice 91 (C52 (d)): marked by `credential:change_visibility` ✦,
/// read by the client's MAIN contacts (C59 (a)) only while
/// `vault.allowPortalCredentials` is on. The database's
/// `portal_vault_switch` policy gives a CONTACT principal zero rows unless
/// the switch is on, the contact is CONTACT_PRIMARY and the login is
/// neither binned nor archived; a SYSTEM read (the reveal broker) restates
/// those terms itself. Switching it off un-marks every login for good
/// (C59 (b)).
model CredentialItem {
  id                String         @id @default(uuid(7))
  tenantId          String         @map("tenant_id")
  clientId          String?        @map("client_id") // NULL = the agency's own (C49)
  projectId         String?        @map("project_id") // anchor/filter; its client must be clientId (trigger)
  type              CredentialType
  name              String
  username          String? // NON-SECRET by contract
  url               String? // http(s) only (service)
  tags              String[]       @default([])
  notes             String? // NON-SECRET notes
  secretFieldKeys   String[]       @default([]) @map("secret_field_keys") // keys only, never values
  hasTotp           Boolean        @default(false) @map("has_totp")
  expiresAt         DateTime?      @map("expires_at") @db.Timestamptz(6)
  rotateEveryDays   Int?           @map("rotate_every_days")
  lastRotatedAt     DateTime?      @map("last_rotated_at") @db.Timestamptz(6)
  needsRotation     Boolean        @default(false) @map("needs_rotation")
  compromisedAt     DateTime?      @map("compromised_at") @db.Timestamptz(6)
  visibility        Visibility     @default(INTERNAL)
  /// Sealed for its client (slice 92, founder decisions C52 (e), C60): the
  /// client is kept out until they ask and wait; staff use it as usual.
  /// CHECKs: a sealed login has a client, is INTERNAL and is not binned.
  sealedAt          DateTime?      @map("sealed_at") @db.Timestamptz(6)
  createdByMemberId String?        @map("created_by_member_id") // attribution, no FK
  updatedByMemberId String?        @map("updated_by_member_id") // attribution, no FK
  /// Handed over by this contact through the portal (slice 96, founder
  /// decision C64; `submission-portal-writes.ts`). Set only by the SYSTEM
  /// principal, never changed; the login is then born INTERNAL with no
  /// member author (migration 20261006180000's guard and CHECKs).
  submittedByContactId String?     @map("submitted_by_contact_id") // attribution, no FK
  /// The name AS THE CLIENT SENT IT (slice 96) — never changes; the client's
  /// own list of what they sent shows this, never `name`, which the team may
  /// rename. Set exactly when `submittedByContactId` is (CHECK).
  submittedName     String?        @map("submitted_name")
  archivedAt        DateTime?      @map("archived_at") @db.Timestamptz(6)
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(6)
  /// Erased by the retention job (slice 99, founder decision C67 (a), (f)):
  /// a login binned 30 days whose secret and versions are gone but whose ROW
  /// is kept — a login a contact SENT, for good, as the client's record of it
  /// (its client, the sender, `submittedName` as its name, `createdAt`); a
  /// login nobody sent, under its own name, only while one of its share
  /// links' records is within its 12 months. Everything else emptied; never
  /// changes again (migrations 20261007220000 and 20261007230000: the CHECK
  /// and the guards). A binned login nobody sent with no such link is deleted
  /// outright instead. Two hand-written PARTIAL indexes Prisma cannot model —
  /// `credential_item_bin_idx` on (tenant_id, deleted_at) WHERE deleted_at IS
  /// NOT NULL AND purged_at IS NULL, and `credential_item_kept_for_links_idx`
  /// on (tenant_id, purged_at) WHERE purged_at IS NOT NULL AND
  /// submitted_by_contact_id IS NULL (the job's picks): a generated
  /// `migrate diff` proposes dropping them; keep them.
  purgedAt          DateTime?      @map("purged_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  client   Client?             @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  project  Project?            @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  secret     CredentialSecret?
  versions   CredentialVersion[]
  shareLinks CredentialShareLink[]

  @@unique([tenantId, id]) // composite-FK target (secret, versions, share links)
  @@index([tenantId, clientId, visibility])
  @@index([tenantId, projectId])
  @@index([tenantId, expiresAt])
  @@index([tenantId, needsRotation])
  @@index([tenantId, submittedByContactId])
  @@map("credential_item")
}

/// CredentialSecret — 1:1 with CredentialItem, CLASS A (portal_deny).
/// `secretCiphertext` = v2 JSON of the type's secret fields, AAD
/// `tenantId:credential_secret:<credentialId>:secret`;
/// `totpSecretCiphertext` = v2 JSON of the TOTP seed and parameters, AAD
/// `…:totp_secret` — codes are generated server-side, the seed is never
/// returned. Both are omitted from every read (src/db/client.ts); only
/// src/modules/vault reads them, and a CHECK refuses anything that is not
/// v2 ciphertext.
model CredentialSecret {
  credentialId         String   @id @map("credential_id")
  tenantId             String   @map("tenant_id")
  secretCiphertext     String   @map("secret_ciphertext")
  totpSecretCiphertext String?  @map("totp_secret_ciphertext")
  version              Int      @default(1) // bumps on every secret change; CredentialVersion keeps the old one
  updatedByMemberId    String?  @map("updated_by_member_id") // attribution, no FK
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  item   CredentialItem @relation(fields: [tenantId, credentialId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, credentialId])
  @@map("credential_secret")
}

/// CredentialVersion — the last 10 previous secrets ("what was the old
/// password"), CLASS A. Re-encrypted under the VERSION row's own AAD
/// `tenantId:credential_version:<id>:secret`, so a version's ciphertext
/// cannot be swapped back onto the live row.
model CredentialVersion {
  id                String   @id @default(uuid(7))
  tenantId          String   @map("tenant_id")
  credentialId      String   @map("credential_id")
  version           Int
  secretCiphertext  String   @map("secret_ciphertext")
  changedByMemberId String?  @map("changed_by_member_id") // attribution, no FK
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  item   CredentialItem @relation(fields: [tenantId, credentialId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, credentialId, version])
  @@map("credential_version")
}

/// CredentialShareLink — CLASS A (portal_deny), Phase 3V slice 90. A
/// view-once link to ONE secret field of one login, for somebody outside
/// the agency. The URL carries `<tenantId>.<random>`; only the sha256 of
/// the random part is stored (`tokenHash`), so the table leaks nothing
/// usable. Resolved under `withTenant(tenantId, {type:'system'})` — never
/// `withPlatform` — and opened only with a 6-digit code mailed to
/// `recipientEmail` (always: founder decision C52 (k) — a portal password
/// alone opens no secret). The value is decrypted at the moment of
/// viewing, and only while the login's secret is still `secretVersion`.
/// Every bound is the database's: at most 5 codes and 5 code checks per
/// link, a lifetime of at most 168 hours from a `createdAt` the guard
/// holds to NOW, `viewedAt` / `revokedAt` one-way, and who writes which
/// column (a member makes and revokes, as themselves; only the share
/// page's SYSTEM principal sends, checks and opens) — the
/// `credential_share_link_guard` trigger. No secret is ever stored here,
/// and a code only as an HMAC under a key the database never holds.
/// src/modules/vault/share-links.ts and share-open.ts. Migration
/// 20261004120000_credential_share_link.
model CredentialShareLink {
  id                String    @id @default(uuid(7))
  tenantId          String    @map("tenant_id")
  credentialId      String    @map("credential_id")
  tokenHash         String    @unique @map("token_hash") // sha256 hex of the token's random part
  field             String // the ONE secret field shared (a key of SECRET_FIELDS)
  includeUsername   Boolean   @default(true) @map("include_username")
  recipientEmail    String    @map("recipient_email") // lowercase; where the code goes
  secretVersion     Int       @map("secret_version") // CredentialSecret.version when shared
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6) // <= createdAt + 168 hours (CHECK)
  codeHash          String?   @map("code_hash") // HMAC-SHA256(`${id}:${code}`) under shareCodeKey, the live code
  codeExpiresAt     DateTime? @map("code_expires_at") @db.Timestamptz(6)
  codeSentAt        DateTime? @map("code_sent_at") @db.Timestamptz(6)
  codesSent         Int       @default(0) @map("codes_sent") // <= 5 (CHECK)
  codeAttempts      Int       @default(0) @map("code_attempts") // every check counts; 5 ends the link
  viewedAt          DateTime? @map("viewed_at") @db.Timestamptz(6) // one-way (trigger)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6) // one-way (trigger)
  revokedByMemberId String?   @map("revoked_by_member_id") // attribution, no FK
  createdByMemberId String    @map("created_by_member_id") // attribution, no FK
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  item   CredentialItem @relation(fields: [tenantId, credentialId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, credentialId, createdAt]) // a login's links, newest first
  @@index([expiresAt]) // the retention sweep (slice 99, `src/modules/vault/retention.ts`)
  @@map("credential_share_link")
}

/// ContactVaultUnlock — A CLIENT'S DOOR to the logins their agency shows
/// them (Phase 3V slice 91; founder decisions C52 (k) and C59 (c)). One row
/// per opening: created after the contact's portal password was checked,
/// with the first mailed six-digit code (keyed HMAC, as share links keep
/// theirs), then open for the vault's step-up window once the right code
/// comes back. Bound to the portal SESSION it was opened in. Written only
/// by the portal's vault broker as SYSTEM (`contact_vault_unlock_guard`);
/// class A, so no contact reads it. Migration 20261005120000.
/// scope=tenant  rls=A (portal_deny)  ret=with the contact (FK cascade)  enc=none (code_hash is a keyed HMAC)
/// audit: portal.logins_code_sent | portal.logins_code_refused | portal.logins_opened
model ContactVaultUnlock {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  contactId     String    @map("contact_id")
  sessionId     String    @map("session_id") // the contact_session row it was opened in (no FK: an auth table)
  codeHash      String?   @map("code_hash") // HMAC-SHA256(`${id}:${code}`) under shareCodeKey, the live code
  codeExpiresAt DateTime? @map("code_expires_at") @db.Timestamptz(6)
  codeSentAt    DateTime  @map("code_sent_at") @db.Timestamptz(6)
  codesSent     Int       @default(1) @map("codes_sent") // 1..5 (CHECK)
  codeAttempts  Int       @default(0) @map("code_attempts") // every check counts; <= 5
  openedAt      DateTime? @map("opened_at") @db.Timestamptz(6) // once (trigger)
  openUntil     DateTime? @map("open_until") @db.Timestamptz(6) // <= openedAt + 15 minutes (CHECK)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  contact Contact @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, contactId, sessionId, createdAt]) // this session's door, newest first
  @@map("contact_vault_unlock")
}

/// SealedOpenRequest — A CLIENT ASKS TO OPEN THE LOGINS THEIR AGENCY KEEPS
/// SEALED FOR THEM (Phase 3V slice 93; founder decisions C52 (f)–(j), C61).
/// One row per ask: a main contact asks with their portal password and a
/// reason; everyone who may answer (`credential:unseal`) is mailed on day
/// 0, 3, 6 and then daily; an answerer APPROVES (it opens at once, for 7
/// days) or DENIES (the client may ask again after 30 days) until the
/// moment it opens; after `waitDays` of silence the client CONFIRMS with
/// their password and a mailed code, and it opens 48 hours later (unless
/// denied in between); a confirmation not made within 30 days of the wait
/// lapses. THE STATE IS DERIVED AT READ TIME FROM THESE STAMPS
/// (`src/lib/ask-and-wait.ts` — the one ask-and-wait machine, C52 (j)); the
/// daily job only mails, so a missed run never delays or extends an
/// opening. `waitDays` is the agency's `vault.sealedWaitDays` when the ask
/// was made, frozen. Every bound is the database's
/// (`sealed_open_request_guard`): who writes which column, the wait, the
/// 48 hours, the 7 days, the 30-day lapse and cool-down, one live ask per
/// client. Class A: the client's view of it is the portal's brokered read.
/// Migration 20261005220000.
/// scope=tenant  rls=A (portal_deny)  ret=with the client (FK cascade)  enc=none
/// audit: credential.open_requested | open_request_refused | open_request_withdrawn | open_request_confirmed | open_request_approved | open_request_denied | open_request_reminded
model SealedOpenRequest {
  id                   String    @id @default(uuid(7))
  tenantId             String    @map("tenant_id")
  clientId             String    @map("client_id")
  askedByContactId     String    @map("asked_by_contact_id") // attribution, no FK
  reason               String // the client's words, 1–1000 characters
  waitDays             Int       @map("wait_days") // 7–60, frozen when asked
  askedAt              DateTime  @default(now()) @map("asked_at") @db.Timestamptz(6)
  confirmedAt          DateTime? @map("confirmed_at") @db.Timestamptz(6)
  confirmedByContactId String?   @map("confirmed_by_contact_id") // attribution, no FK
  approvedAt           DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedByMemberId   String?   @map("approved_by_member_id") // attribution, no FK
  deniedAt             DateTime? @map("denied_at") @db.Timestamptz(6)
  deniedByMemberId     String?   @map("denied_by_member_id") // attribution, no FK
  denyReason           String?   @map("deny_reason") // shown to the client; ≤ 1000
  withdrawnAt          DateTime? @map("withdrawn_at") @db.Timestamptz(6)
  withdrawnByContactId String?   @map("withdrawn_by_contact_id") // attribution, no FK
  opensAt              DateTime? @map("opens_at") @db.Timestamptz(6) // approved: then; confirmed: + 48 hours
  openUntil            DateTime? @map("open_until") @db.Timestamptz(6) // opensAt + 7 days
  remindersSent        Int       @default(0) @map("reminders_sent") // the answerers' mails so far (day 0 included)
  lastRemindedAt       DateTime? @map("last_reminded_at") @db.Timestamptz(6)
  openedNoticeAt       DateTime? @map("opened_notice_at") @db.Timestamptz(6) // the agency told it opened
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  client Client @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, clientId, askedAt]) // a client's asks, newest first
  @@map("sealed_open_request")
}

/// CredentialAsk — THE AGENCY ASKS A CLIENT FOR A NAMED LOGIN (Phase 3V
/// slice 98; founder decision C66, C64 (a)'s later slice). A member who may
/// add a login there asks ONE contact of the client — a main contact or a
/// helper — for something they need ("Hosting control panel"), with an
/// optional note; both are SHOWN TO THAT CONTACT. The contact is mailed
/// once (a link, naming nothing) and sees the ask under "Waiting on you";
/// they SEND it (a slice-96 hand-over, anchored where the ask says) or
/// DECLINE it with a short note; the team may CANCEL it. Exactly one of
/// the three ends it; nothing expires. Every bound is the database's
/// (`credential_ask_guard`): a member asks and cancels as themselves, only
/// the portal's broker (SYSTEM) records a send or a decline, and nothing
/// that was asked ever changes. Class A: the contact reads it only through
/// the portal's brokered reads. Migration 20261007180000, which also adds a
/// hand-written partial UNIQUE Prisma cannot model —
/// `credential_ask_sent_credential_unique` on (tenant_id, sent_credential_id)
/// WHERE sent_credential_id IS NOT NULL (one login answers one ask): a
/// generated `migrate diff` proposes dropping it, like the other partial
/// uniques; keep it.
/// scope=tenant  rls=A (portal_deny)  ret=with its client, project or contact (FK cascade)  enc=none
/// audit: credential.asked | ask_cancelled | ask_declined (a send is `credential.submitted` with `askId`)
model CredentialAsk {
  id                   String         @id @default(uuid(7))
  tenantId             String         @map("tenant_id")
  clientId             String         @map("client_id")
  projectId            String?        @map("project_id") // where the login will land; the guard holds it to the client
  contactId            String         @map("contact_id") // the ONE person asked (C66 (a)); FK — an unanswered ask goes with them
  type                 CredentialType // what kind the team expects; the client may send another
  name                 String // what the team needs — SHOWN TO THE CLIENT; 1–200
  note                 String? // the team's note — SHOWN TO THE CLIENT; ≤ 1000
  requestedByMemberId  String         @map("requested_by_member_id") // attribution, no FK
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt               DateTime?      @map("sent_at") @db.Timestamptz(6)
  sentCredentialId     String?        @map("sent_credential_id") // the login it became; no FK (a login may be purged later)
  declinedAt           DateTime?      @map("declined_at") @db.Timestamptz(6)
  declinedByContactId  String?        @map("declined_by_contact_id") // attribution, no FK
  declineNote          String?        @map("decline_note") // the client's words to the team; ≤ 500
  cancelledAt          DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  cancelledByMemberId  String?        @map("cancelled_by_member_id") // attribution, no FK

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  client  Client   @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Cascade)
  project Project? @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  contact Contact  @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, clientId, createdAt]) // a client's asks, newest first
  @@index([tenantId, contactId, createdAt]) // the asked person's own, and the per-contact cap
  @@index([tenantId, projectId])
  @@map("credential_ask")
}

// ───────────────────────────────────────────────────────────────────
// 6.17 ASSETS (Phase 3V slice 87) — module `vault`. The client's asset
// registry: domains, hosting, DNS zones, SSL certificates, mailboxes,
// CMS/apps, third-party services, licences — what the agency looks
// after for the client, with renewal dates and costs. NON-SECRET by
// contract: a password or a licence KEY is a credential (the vault),
// never an asset field, and assets are NOT behind the vault's door.
// Feeds the expirations feed (slice 88). Migration
// 20261003120000_client_asset.
// ───────────────────────────────────────────────────────────────────

enum AssetType {
  DOMAIN
  HOSTING
  DNS_ZONE
  SSL_CERT
  EMAIL
  CMS_APP
  THIRD_PARTY_SERVICE
  LICENSE
  CUSTOM

  @@map("asset_type")
}

/// Set by a person, never derived: "expiring" and "expired" are computed
/// from `expiresAt` where they are shown, so they cannot go stale between
/// job runs (DATA_MODEL §6.17's EXPIRING/EXPIRED were dropped, slice 87).
enum AssetStatus {
  ACTIVE // in use — on the expirations feed when it has a date
  RETIRED // kept for the record (a moved domain, a cancelled plan); off the feed

  @@map("asset_status")
}

/// ClientAsset — class B, clientScoped (`projectId` is an anchor and a
/// filter, never a portal gate, so no `portal_enabled`). Scope follows
/// the vault's anchor rules: a project's asset on the project axis, a
/// client-level one (`projectId` NULL) for DIRECT client assignment only
/// (AUTHZ §4). `fields` holds the type's few extra facts (nameservers,
/// plan, seats…), validated per type by zod in `asset-fields.ts`.
/// Visibility is INTERNAL in v1 (`client_asset_internal_only`): no portal
/// surface shows assets yet. A renewal cost and its currency are set or
/// cleared together (CHECK).
model ClientAsset {
  id                String      @id @default(uuid(7))
  tenantId          String      @map("tenant_id")
  clientId          String      @map("client_id")
  projectId         String?     @map("project_id") // anchor/filter; its client must be clientId (trigger)
  type              AssetType
  name              String
  provider          String? // the registrar, host or vendor
  url               String? // http(s) only (service + CHECK)
  identifier        String? // the domain name, account id, certificate serial…
  status            AssetStatus @default(ACTIVE)
  expiresAt         DateTime?   @map("expires_at") @db.Timestamptz(6) // a renewal DATE, stored as UTC midnight
  autoRenew         Boolean?    @map("auto_renew") // NULL = not known
  renewalCost       Decimal?    @map("renewal_cost") @db.Decimal(12, 2)
  currency          String?     @db.Char(3)
  fields            Json        @default("{}") // per type, zod-validated (asset-fields.ts)
  notes             String? // NON-SECRET notes
  tags              String[]    @default([])
  visibility        Visibility  @default(INTERNAL)
  createdByMemberId String?     @map("created_by_member_id") // attribution, no FK
  updatedByMemberId String?     @map("updated_by_member_id") // attribution, no FK
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  client  Client   @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  project Project? @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, clientId, visibility])
  @@index([tenantId, projectId])
  @@index([tenantId, expiresAt]) // the expirations feed (slice 88)
  @@map("client_asset")
}

/// ExpirationReminderSent — class A, the renewal reminders' dedupe (Phase
/// 3V slice 89; DATA_MODEL.md §6.17). One row per reminder that went out:
/// the subject, the DAY it was about, and the band (60/30/14/7/1 days
/// before). The primary key IS the dedupe — the daily job INSERTs ... ON
/// CONFLICT DO NOTHING, and a conflict means "already sent". `dueOn` is in
/// the key so a changed date re-arms by itself (a renewed domain's new
/// date has sent nothing), with no writer of the subject having to clear
/// anything. Logins are deduplicated per LOGIN even though they are
/// announced as a count per client (C56): a login that enters a band later
/// than its neighbours is still told once. No FK to the subject (the column
/// is polymorphic): the job's own sweep deletes a row once its day has
/// passed, which is when it can no longer matter.
model ExpirationReminderSent {
  tenantId    String   @map("tenant_id")
  subjectType String   @map("subject_type") // "ClientAsset" | "Service" | "CredentialItem" (CHECK)
  subjectId   String   @map("subject_id")
  dueOn       DateTime @map("due_on") @db.Date // the UTC day of the date reminded about
  offsetDays  Int      @map("offset_days") // 60 | 30 | 14 | 7 | 1 (CHECK)
  sentAt      DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, subjectType, subjectId, dueOn, offsetDays])
  @@index([tenantId, dueOn]) // the sweep
  @@map("expiration_reminder_sent")
}
